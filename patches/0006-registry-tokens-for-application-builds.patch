+// registryToken answers a PathOps registry token request: only for the
+// configured clients and workload connector, from an ID token, and only for an
+// Application build ServiceAccount (registry.Issuer). A refusal says nothing
+// about why; the log does.
+func (g *tokenExchange) registryToken(ctx context.Context, req *Request, client storage.Client, subject string) (Responder, error) {
+	if g.registry == nil {
+		return nil, &oauth2.Error{Type: oauth2.RequestNotSupported, Description: "Invalid requested_token_type.", Status: http.StatusBadRequest}
+	}
+	if !g.registry.Client(client.ID, req.ConnectorID) || req.SubjectTokenType != oauth2.TokenTypeID {
+		g.logger.WarnContext(ctx, "registry token refused: client, connector or subject token type",
+			"client_id", client.ID, "connector_id", req.ConnectorID, "subject_token_type", req.SubjectTokenType)
+		return nil, &oauth2.Error{Type: oauth2.AccessDenied, Status: http.StatusForbidden}
+	}
+	token, expiry, err := g.registry.Issue(ctx, subject)
+	if errors.Is(err, registry.ErrDenied) {
+		g.logger.WarnContext(ctx, "registry token refused", "user_id", subject, "err", err)
+		return nil, &oauth2.Error{Type: oauth2.AccessDenied, Status: http.StatusForbidden}
+	}
+	if err != nil {
+		g.logger.ErrorContext(ctx, "registry token failed", "user_id", subject, "err", err)
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	g.logger.InfoContext(ctx, "registry token issued", "client_id", client.ID, "user_id", subject, "expiry", expiry)
+	return tokens.Response{
+		AccessToken:     token,
+		IssuedTokenType: registry.TokenType,
+		TokenType:       "bearer",
+		ExpiresIn:       int(time.Until(expiry).Seconds()),
+	}, nil
+}
