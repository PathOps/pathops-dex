+package registry
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+const appA = "11111111-1111-4111-8111-111111111111"
+
+var testConfig = Config{Clients: []string{"zot"}, Connector: "k8s-cell", Issuer: "https://dex.example.org/registry",
+	Audience: "zot", KeyID: "registry-1"}
+
+// cluster is a fake Kubernetes: labels by "namespace" or "namespace/sa".
+type cluster map[string]map[string]string
+
+func (c cluster) lookup(_ context.Context, ns, sa string) (map[string]string, error) {
+	k := ns
+	if sa != "" {
+		k += "/" + sa
+	}
+	l, ok := c[k]
+	if !ok {
+		return nil, ErrNotFound
+	}
+	return l, nil
+}
+
+func goodCluster() cluster {
+	return cluster{
+		"app-a-ci":             {LabelApplication: appA, LabelCI: "true"},
+		"app-a-ci/app-a-build": {LabelApplication: appA, LabelCapability: CapabilityBuild},
+	}
+}
+
+func newTestIssuer(t *testing.T, c cluster) (*Issuer, ed25519.PublicKey) {
+	t.Helper()
+	pub, key, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	i, err := New(testConfig, key, c.lookup)
+	require.NoError(t, err)
+	return i, pub
+}
+
+func TestIssue(t *testing.T) {
+	i, pub := newTestIssuer(t, goodCluster())
+	now := time.Unix(1_800_000_000, 0)
+	i.Now = func() time.Time { return now }
+	tok, exp, err := i.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-build")
+	require.NoError(t, err)
+	require.Equal(t, now.Add(5*time.Minute).UTC(), exp)
+
+	parts := strings.Split(tok, ".")
+	require.Len(t, parts, 3)
+	sig, _ := base64.RawURLEncoding.DecodeString(parts[2])
+	require.True(t, ed25519.Verify(pub, []byte(parts[0]+"."+parts[1]), sig))
+	var header, claims map[string]any
+	raw, _ := base64.RawURLEncoding.DecodeString(parts[0])
+	require.NoError(t, json.Unmarshal(raw, &header))
+	raw, _ = base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, json.Unmarshal(raw, &claims))
+	require.Equal(t, map[string]any{"alg": "EdDSA", "typ": "JWT", "kid": "registry-1"}, header)
+	require.Equal(t, "https://dex.example.org/registry", claims["iss"])
+	require.Equal(t, "zot", claims["aud"])
+	require.Equal(t, "system:serviceaccount:app-a-ci:app-a-build", claims["sub"])
+	require.Equal(t, appA, claims["pathops_application"])
+	require.EqualValues(t, now.Unix(), claims["iat"])
+	require.EqualValues(t, now.Unix()+300, claims["exp"])
+	require.NotEmpty(t, claims["jti"])
+	require.Equal(t, []any{map[string]any{"type": "repository", "name": "apps/" + appA, "actions": []any{"pull", "push"}}}, claims["access"])
+}
+
+func TestIssueDenied(t *testing.T) {
+	for name, tc := range map[string]struct {
+		subject string
+		change  func(cluster)
+	}{
+		"not a ServiceAccount":          {subject: "alice"},
+		"user that looks like one":      {subject: "system:serviceaccount:app-a-ci"},
+		"another ServiceAccount":        {subject: "system:serviceaccount:app-a-ci:default"},
+		"trigger ServiceAccount":        {subject: "system:serviceaccount:app-a-ci:build-and-push-trigger"},
+		"another Application's name":    {subject: "system:serviceaccount:app-a-ci:app-b-build"},
+		"not a CI namespace":            {subject: "system:serviceaccount:app-a:app-a-build"},
+		"platform namespace":            {subject: "system:serviceaccount:kube-system:app-a-build"},
+		"namespace missing":             {subject: "system:serviceaccount:app-c-ci:app-c-build"},
+		"ServiceAccount missing":        {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { delete(c, "app-a-ci/app-a-build") }},
+		"namespace without Application": {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { delete(c["app-a-ci"], LabelApplication) }},
+		"namespace not labeled CI":      {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { c["app-a-ci"][LabelCI] = "false" }},
+		"ServiceAccount of another app": {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { c["app-a-ci/app-a-build"][LabelApplication] = "22222222-2222-4222-8222-222222222222" }},
+		"ServiceAccount without label":  {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { delete(c["app-a-ci/app-a-build"], LabelApplication) }},
+		"ServiceAccount no capability":  {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) { delete(c["app-a-ci/app-a-build"], LabelCapability) }},
+		"Application id not a UUID": {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) {
+			c["app-a-ci"][LabelApplication] = "../b"
+			c["app-a-ci/app-a-build"][LabelApplication] = "../b"
+		}},
+		"Application id with wildcards": {subject: "system:serviceaccount:app-a-ci:app-a-build", change: func(c cluster) {
+			c["app-a-ci"][LabelApplication] = "*"
+			c["app-a-ci/app-a-build"][LabelApplication] = "*"
+		}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			c := goodCluster()
+			if tc.change != nil {
+				tc.change(c)
+			}
+			i, _ := newTestIssuer(t, c)
+			_, _, err := i.Issue(t.Context(), tc.subject)
+			require.ErrorIs(t, err, ErrDenied)
+		})
+	}
+	// A failing Kubernetes API is no authority either.
+	i, _ := newTestIssuer(t, goodCluster())
+	i.Lookup = func(context.Context, string, string) (map[string]string, error) {
+		return nil, errors.New("unavailable")
+	}
+	_, _, err := i.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-build")
+	require.ErrorIs(t, err, ErrDenied)
+}
+
+func TestClient(t *testing.T) {
+	i, _ := newTestIssuer(t, goodCluster())
+	require.True(t, i.Client("zot", "k8s-cell"))
+	require.False(t, i.Client("pathops-cli", "k8s-cell"))
+	require.False(t, i.Client("zot", "local"))
+}
+
+func TestNewValidates(t *testing.T) {
+	_, key, _ := ed25519.GenerateKey(rand.Reader)
+	for name, change := range map[string]func(*Config){
+		"no clients":          func(c *Config) { c.Clients = nil },
+		"no connector":        func(c *Config) { c.Connector = "" },
+		"no audience":         func(c *Config) { c.Audience = "" },
+		"no key id":           func(c *Config) { c.KeyID = "" },
+		"http issuer":         func(c *Config) { c.Issuer = "http://dex.example.org/registry" },
+		"lifetime over 5m":    func(c *Config) { c.ValidFor = "6m" },
+		"lifetime negative":   func(c *Config) { c.ValidFor = "-1s" },
+		"prefix without /":    func(c *Config) { c.RepositoryPrefix = "apps" },
+		"prefix with pattern": func(c *Config) { c.RepositoryPrefix = "apps/*/" },
+	} {
+		c := testConfig
+		change(&c)
+		_, err := New(c, key, goodCluster().lookup)
+		require.Error(t, err, name)
+	}
+	_, err := New(testConfig, nil, goodCluster().lookup)
+	require.Error(t, err, "no key")
+}
