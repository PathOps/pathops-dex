+// The registry token type is served only when registry tokens are enabled,
+// and only for build workloads (the mock identity is not one).
+func TestHandleTokenExchangeRegistry(t *testing.T) {
+	for name, tc := range map[string]struct {
+		enabled bool
+		want    int
+	}{
+		"disabled":                  {false, http.StatusBadRequest},
+		"mock user is not workload": {true, http.StatusForbidden},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ctx := t.Context()
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.Storage.CreateClient(ctx, storage.Client{ID: "zot", Secret: "s"})
+				if tc.enabled {
+					_, key, _ := ed25519.GenerateKey(rand.Reader)
+					iss, err := registry.New(registry.Config{Clients: []string{"zot"}, Connector: "mock",
+						Issuer: "https://dex.example.org/registry", Audience: "zot", KeyID: "registry-1"}, key,
+						func(context.Context, string, string) (map[string]string, error) { return nil, registry.ErrNotFound })
+					require.NoError(t, err)
+					c.RegistryTokens = iss
+				}
+			})
+			defer httpServer.Close()
+			vals := url.Values{"grant_type": {oauth2.GrantTypeTokenExchange}, "connector_id": {"mock"}, "scope": {"openid"},
+				"requested_token_type": {registry.TokenType}, "subject_token_type": {oauth2.TokenTypeID},
+				"subject_token": {"foobar"}, "client_id": {"zot"}, "client_secret": {"s"}}
+			rr := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+			req.Header.Set("content-type", "application/x-www-form-urlencoded")
+			s.ServeHTTP(rr, req)
+			require.Equal(t, tc.want, rr.Code, rr.Body.String())
+		})
+	}
+}
