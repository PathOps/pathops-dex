+package grants
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"io"
+	"log/slog"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/registry"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+func TestRegistryToken(t *testing.T) {
+	_, key, _ := ed25519.GenerateKey(rand.Reader)
+	const app = "11111111-1111-4111-8111-111111111111"
+	labels := map[string]map[string]string{
+		"app-a-ci":             {registry.LabelApplication: app, registry.LabelCI: "true"},
+		"app-a-ci/app-a-build": {registry.LabelApplication: app, registry.LabelCapability: registry.CapabilityBuild},
+	}
+	iss, err := registry.New(registry.Config{Clients: []string{"zot"}, Connector: "k8s-cell", Issuer: "https://dex.example.org/registry",
+		Audience: "zot", KeyID: "registry-1"}, key, func(_ context.Context, ns, sa string) (map[string]string, error) {
+		k := ns
+		if sa != "" {
+			k += "/" + sa
+		}
+		return labels[k], nil
+	})
+	require.NoError(t, err)
+	g := &tokenExchange{logger: slog.New(slog.NewTextHandler(io.Discard, nil)), registry: iss}
+	req := &Request{ConnectorID: "k8s-cell", SubjectTokenType: oauth2.TokenTypeID}
+	zot := storage.Client{ID: "zot", Public: true}
+
+	out, err := g.registryToken(t.Context(), req, zot, "system:serviceaccount:app-a-ci:app-a-build")
+	require.NoError(t, err)
+	res := out.(tokens.Response)
+	require.Equal(t, registry.TokenType, res.IssuedTokenType)
+	require.NotEmpty(t, res.AccessToken)
+	require.LessOrEqual(t, res.ExpiresIn, 300)
+
+	denied := func(req *Request, client storage.Client, subject string) {
+		t.Helper()
+		_, err := g.registryToken(t.Context(), req, client, subject)
+		var oe *oauth2.Error
+		require.ErrorAs(t, err, &oe)
+		require.Equal(t, oauth2.AccessDenied, oe.Type)
+		require.Equal(t, http.StatusForbidden, oe.Status)
+	}
+	denied(req, storage.Client{ID: "pathops-cli"}, "system:serviceaccount:app-a-ci:app-a-build")
+	denied(&Request{ConnectorID: "local", SubjectTokenType: oauth2.TokenTypeID}, zot, "system:serviceaccount:app-a-ci:app-a-build")
+	denied(&Request{ConnectorID: "k8s-cell", SubjectTokenType: oauth2.TokenTypeAccess}, zot, "system:serviceaccount:app-a-ci:app-a-build")
+	denied(req, zot, "system:serviceaccount:app-a-ci:default")
+
+	// Disabled: the token type is not supported.
+	_, err = (&tokenExchange{logger: g.logger}).registryToken(t.Context(), req, zot, "system:serviceaccount:app-a-ci:app-a-build")
+	var oe *oauth2.Error
+	require.ErrorAs(t, err, &oe)
+	require.Equal(t, oauth2.RequestNotSupported, oe.Type)
+}
diff --git a/server/registry/registry.go b/server/registry/registry.go
new file mode 100644
index 0000000..be33d54
--- /dev/null
+++ b/server/registry/registry.go
@@ -0,0 +1,306 @@
+// Package registry is the PathOps extension that issues registry tokens to
+// Application build workloads (PathOps Decision 0056).
+//
+// An Application's build ServiceAccount (<app>-build in <app>-ci) exchanges
+// its projected Kubernetes token at Dex (RFC 8693, through the Kubernetes
+// workload connector) for a short-lived registry token:
+//
+//	requested_token_type = urn:pathops:params:oauth:token-type:registry
+//
+// The token is a JWT signed with a dedicated Ed25519 key (never Dex's OIDC
+// keys, so the registry's OIDC validation cannot accept it) and carries the
+// Docker Distribution "access" claim for exactly one repository, the
+// Application's, with pull and push:
+//
+//	{"iss": <registry issuer>, "sub": "system:serviceaccount:<app>-ci:<app>-build",
+//	 "aud": <registry audience>, "iat", "nbf", "exp" (at most 5 minutes), "jti",
+//	 "pathops_application": <application id>,
+//	 "access": [{"type": "repository", "name": "<prefix><application id>", "actions": ["pull", "push"]}]}
+//
+// The Application id comes from the Kubernetes API, not from the request: the
+// workload's Namespace and ServiceAccount must both carry the same
+// pathops.io/application-id label, the Namespace pathops.io/ci=true and the
+// ServiceAccount pathops.io/capability=build-and-push. Those labels are
+// written only by PathOps provisioning (protected by Cell admission). Any
+// other ServiceAccount gets no registry authority.
+package registry
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+)
+
+// TokenType is the RFC 8693 requested_token_type of a registry token.
+const TokenType = "urn:pathops:params:oauth:token-type:registry"
+
+// Labels the workload's Namespace and ServiceAccount must carry.
+const (
+	LabelApplication = "pathops.io/application-id"
+	LabelCI          = "pathops.io/ci"
+	LabelCapability  = "pathops.io/capability"
+	CapabilityBuild  = "build-and-push"
+)
+
+// Config is the "registryTokens" section of the Dex configuration.
+type Config struct {
+	// Clients are the OAuth clients that may request registry tokens.
+	Clients []string `json:"clients"`
+	// Connector is the Kubernetes workload connector whose identities may
+	// get registry tokens.
+	Connector string `json:"connector"`
+	// Issuer is the tokens' "iss" (not Dex's issuer) and Audience their "aud".
+	Issuer   string `json:"issuer"`
+	Audience string `json:"audience"`
+	// SigningKeyFile is the Ed25519 private key (PEM, PKCS#8); KeyID its "kid".
+	SigningKeyFile string `json:"signingKeyFile"`
+	KeyID          string `json:"keyID"`
+	// ValidFor is the tokens' lifetime (default and maximum 5m).
+	ValidFor string `json:"validFor"`
+	// RepositoryPrefix prefixes the Application id (default "apps/").
+	RepositoryPrefix string `json:"repositoryPrefix"`
+}
+
+// Issuer issues registry tokens.
+type Issuer struct {
+	clients   []string
+	connector string
+	issuer    string
+	audience  string
+	key       ed25519.PrivateKey
+	keyID     string
+	ttl       time.Duration
+	prefix    string
+	// Lookup returns the labels of a Namespace (sa == "") or of a
+	// ServiceAccount; ErrNotFound when it does not exist.
+	Lookup func(ctx context.Context, namespace, sa string) (map[string]string, error)
+	Now    func() time.Time
+}
+
+// ErrNotFound: the Kubernetes object does not exist.
+var ErrNotFound = errors.New("not found")
+
+// ErrDenied: the identity has no registry authority. The reason is logged,
+// never returned to the client.
+var ErrDenied = errors.New("registry token denied")
+
+var (
+	identifier = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+	dnsLabel   = regexp.MustCompile(`^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$`)
+	uuid       = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+	prefix     = regexp.MustCompile(`^([a-z0-9]+(?:[._-][a-z0-9]+)*/)+$`)
+)
+
+// NewIssuer validates c, loads its key and reads labels from the in-cluster
+// Kubernetes API as Dex's own ServiceAccount.
+func NewIssuer(c Config) (*Issuer, error) {
+	raw, err := os.ReadFile(c.SigningKeyFile)
+	if err != nil {
+		return nil, fmt.Errorf("registryTokens.signingKeyFile: %v", err)
+	}
+	block, _ := pem.Decode(raw)
+	if block == nil || block.Type != "PRIVATE KEY" {
+		return nil, errors.New("registryTokens.signingKeyFile is not a PEM PRIVATE KEY")
+	}
+	k, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	key, ok := k.(ed25519.PrivateKey)
+	if err != nil || !ok {
+		return nil, errors.New("registryTokens.signingKeyFile is not an Ed25519 key")
+	}
+	i, err := New(c, key, nil)
+	if err != nil {
+		return nil, err
+	}
+	kc, err := inCluster()
+	if err != nil {
+		return nil, fmt.Errorf("registryTokens: the Kubernetes API: %v", err)
+	}
+	i.Lookup = kc.labels
+	return i, nil
+}
+
+// New validates c (its SigningKeyFile is not read) and returns an Issuer
+// signing with key and reading labels with lookup.
+func New(c Config, key ed25519.PrivateKey, lookup func(ctx context.Context, namespace, sa string) (map[string]string, error)) (*Issuer, error) {
+	i := &Issuer{clients: c.Clients, connector: c.Connector, issuer: c.Issuer, audience: c.Audience, keyID: c.KeyID,
+		key: key, ttl: 5 * time.Minute, prefix: c.RepositoryPrefix, Lookup: lookup, Now: time.Now}
+	if len(c.Clients) == 0 || slices.ContainsFunc(c.Clients, func(s string) bool { return !identifier.MatchString(s) }) {
+		return nil, errors.New("registryTokens.clients must name client ids")
+	}
+	if !identifier.MatchString(c.Connector) || !identifier.MatchString(c.KeyID) || c.Audience == "" {
+		return nil, errors.New("registryTokens.connector, keyID and audience are required")
+	}
+	if u, err := url.Parse(c.Issuer); err != nil || u.Scheme != "https" || u.Host == "" {
+		return nil, errors.New("registryTokens.issuer must be an https URL")
+	}
+	if c.ValidFor != "" {
+		d, err := time.ParseDuration(c.ValidFor)
+		if err != nil || d <= 0 || d > 5*time.Minute {
+			return nil, errors.New("registryTokens.validFor must be positive and at most 5m")
+		}
+		i.ttl = d
+	}
+	if i.prefix == "" {
+		i.prefix = "apps/"
+	}
+	if !prefix.MatchString(i.prefix) {
+		return nil, fmt.Errorf("registryTokens.repositoryPrefix %q is not a repository path prefix ending in /", i.prefix)
+	}
+	if len(key) != ed25519.PrivateKeySize {
+		return nil, errors.New("registryTokens: an Ed25519 signing key is required")
+	}
+	return i, nil
+}
+
+// Client reports whether clientID may request registry tokens through
+// connectorID.
+func (i *Issuer) Client(clientID, connectorID string) bool {
+	return connectorID == i.connector && slices.Contains(i.clients, clientID)
+}
+
+// Issue returns a registry token for the workload subject (the connector's
+// verified "sub": system:serviceaccount:<namespace>:<name>).
+func (i *Issuer) Issue(ctx context.Context, subject string) (string, time.Time, error) {
+	app, err := i.application(ctx, subject)
+	if err != nil {
+		return "", time.Time{}, err
+	}
+	now := i.Now().UTC().Truncate(time.Second)
+	exp := now.Add(i.ttl)
+	jti := make([]byte, 16)
+	if _, err := rand.Read(jti); err != nil {
+		return "", time.Time{}, err
+	}
+	header, _ := json.Marshal(map[string]string{"alg": "EdDSA", "typ": "JWT", "kid": i.keyID})
+	claims, err := json.Marshal(map[string]any{
+		"iss": i.issuer, "sub": subject, "aud": i.audience,
+		"iat": now.Unix(), "nbf": now.Unix(), "exp": exp.Unix(), "jti": hex.EncodeToString(jti),
+		"pathops_application": app,
+		"access":              []map[string]any{{"type": "repository", "name": i.prefix + app, "actions": []string{"pull", "push"}}},
+	})
+	if err != nil {
+		return "", time.Time{}, err
+	}
+	in := base64.RawURLEncoding.EncodeToString(header) + "." + base64.RawURLEncoding.EncodeToString(claims)
+	return in + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(i.key, []byte(in))), exp, nil
+}
+
+// application is the Application id of a build workload, or ErrDenied.
+func (i *Issuer) application(ctx context.Context, subject string) (string, error) {
+	parts := strings.Split(subject, ":")
+	if len(parts) != 4 || parts[0] != "system" || parts[1] != "serviceaccount" {
+		return "", fmt.Errorf("%w: %q is not a ServiceAccount", ErrDenied, subject)
+	}
+	ns, sa := parts[2], parts[3]
+	app, ok := strings.CutSuffix(ns, "-ci")
+	if !ok || !dnsLabel.MatchString(ns) || app == "" || sa != app+"-build" {
+		return "", fmt.Errorf("%w: %s is not an Application build ServiceAccount (<app>-build in <app>-ci)", ErrDenied, subject)
+	}
+	nsLabels, err := i.Lookup(ctx, ns, "")
+	if err != nil {
+		return "", fmt.Errorf("%w: Namespace %s: %v", ErrDenied, ns, err)
+	}
+	saLabels, err := i.Lookup(ctx, ns, sa)
+	if err != nil {
+		return "", fmt.Errorf("%w: ServiceAccount %s/%s: %v", ErrDenied, ns, sa, err)
+	}
+	id := nsLabels[LabelApplication]
+	switch {
+	case !uuid.MatchString(id):
+		return "", fmt.Errorf("%w: Namespace %s has no Application id", ErrDenied, ns)
+	case nsLabels[LabelCI] != "true":
+		return "", fmt.Errorf("%w: Namespace %s is not a CI namespace", ErrDenied, ns)
+	case saLabels[LabelApplication] != id:
+		return "", fmt.Errorf("%w: ServiceAccount %s/%s is not of Application %s", ErrDenied, ns, sa, id)
+	case saLabels[LabelCapability] != CapabilityBuild:
+		return "", fmt.Errorf("%w: ServiceAccount %s/%s has no %s capability", ErrDenied, ns, sa, CapabilityBuild)
+	}
+	return id, nil
+}
+
+// kube reads object labels from the in-cluster Kubernetes API as Dex's own
+// ServiceAccount (get namespaces and serviceaccounts).
+type kube struct {
+	base      string
+	tokenFile string
+	http      *http.Client
+}
+
+const serviceAccountDir = "/var/run/secrets/kubernetes.io/serviceaccount"
+
+func inCluster() (*kube, error) {
+	host, port := os.Getenv("KUBERNETES_SERVICE_HOST"), os.Getenv("KUBERNETES_SERVICE_PORT")
+	if host == "" || port == "" {
+		return nil, errors.New("not running in a cluster (KUBERNETES_SERVICE_HOST/PORT unset)")
+	}
+	ca, err := os.ReadFile(serviceAccountDir + "/ca.crt")
+	if err != nil {
+		return nil, err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(ca) {
+		return nil, errors.New("no certificate in the ServiceAccount CA")
+	}
+	tr := http.DefaultTransport.(*http.Transport).Clone()
+	tr.TLSClientConfig = &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
+	return &kube{base: "https://" + strings.Trim(host, "[]") + ":" + port, tokenFile: serviceAccountDir + "/token",
+		http: &http.Client{Timeout: 10 * time.Second, Transport: tr}}, nil
+}
+
+func (k *kube) labels(ctx context.Context, namespace, sa string) (map[string]string, error) {
+	path := "/api/v1/namespaces/" + url.PathEscape(namespace)
+	if sa != "" {
+		path += "/serviceaccounts/" + url.PathEscape(sa)
+	}
+	// The kubelet rotates the projected token: read it for every request.
+	token, err := os.ReadFile(k.tokenFile)
+	if err != nil {
+		return nil, err
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, k.base+path, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+strings.TrimSpace(string(token)))
+	req.Header.Set("Accept", "application/json")
+	resp, err := k.http.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case resp.StatusCode == http.StatusNotFound:
+		return nil, ErrNotFound
+	case resp.StatusCode != http.StatusOK:
+		return nil, fmt.Errorf("GET %s: HTTP %d", path, resp.StatusCode)
+	}
+	var obj struct {
+		Metadata struct {
+			Labels map[string]string `json:"labels"`
+		} `json:"metadata"`
+	}
+	if err := json.Unmarshal(body, &obj); err != nil {
+		return nil, err
+	}
+	return obj.Metadata.Labels, nil
+}
