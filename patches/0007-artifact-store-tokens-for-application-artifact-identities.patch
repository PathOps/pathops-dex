diff --git a/server/grants/tokenexchange_registry_test.go b/server/grants/tokenexchange_registry_test.go
index fc7d690..23ddaeb 100644
--- a/server/grants/tokenexchange_registry_test.go
+++ b/server/grants/tokenexchange_registry_test.go
@@ -63,3 +63,49 @@ func TestRegistryToken(t *testing.T) {
 	require.ErrorAs(t, err, &oe)
 	require.Equal(t, oauth2.RequestNotSupported, oe.Type)
 }
+
+func TestArtifactToken(t *testing.T) {
+	_, key, _ := ed25519.GenerateKey(rand.Reader)
+	const app = "11111111-1111-4111-8111-111111111111"
+	labels := map[string]map[string]string{
+		"app-a-ci":                {registry.LabelApplication: app, registry.LabelCI: "true"},
+		"app-a-ci/app-a-artifact": {registry.LabelApplication: app, registry.LabelCapability: registry.CapabilityArtifact},
+		"app-a-ci/app-a-build":    {registry.LabelApplication: app, registry.LabelCapability: registry.CapabilityBuild},
+	}
+	lookup := func(_ context.Context, ns, sa string) (map[string]string, error) {
+		k := ns
+		if sa != "" {
+			k += "/" + sa
+		}
+		return labels[k], nil
+	}
+	art, err := registry.NewArtifact(registry.ArtifactConfig{Clients: []string{"pathops-artifact-store"}, Connector: "k8s-cell",
+		Issuer: "https://dex.example.org/artifacts", Audience: "pathops-artifact-store", KeyID: "artifact-1"}, key, lookup)
+	require.NoError(t, err)
+	g := &tokenExchange{logger: slog.New(slog.NewTextHandler(io.Discard, nil)), artifact: art}
+	req := &Request{ConnectorID: "k8s-cell", SubjectTokenType: oauth2.TokenTypeID}
+	store := storage.Client{ID: "pathops-artifact-store"}
+
+	out, err := g.artifactToken(t.Context(), req, store, "system:serviceaccount:app-a-ci:app-a-artifact")
+	require.NoError(t, err)
+	res := out.(tokens.Response)
+	require.Equal(t, registry.ArtifactTokenType, res.IssuedTokenType)
+	require.LessOrEqual(t, res.ExpiresIn, 300)
+
+	denied := func(client storage.Client, subject string) {
+		t.Helper()
+		_, err := g.artifactToken(t.Context(), req, client, subject)
+		var oe *oauth2.Error
+		require.ErrorAs(t, err, &oe)
+		require.Equal(t, oauth2.AccessDenied, oe.Type)
+	}
+	denied(storage.Client{ID: "zot"}, "system:serviceaccount:app-a-ci:app-a-artifact")
+	denied(store, "system:serviceaccount:app-a-ci:app-a-build")
+
+	// Registry tokens disabled here: the registry token type is not supported,
+	// and an artifact identity cannot reach it.
+	_, err = g.registryToken(t.Context(), req, storage.Client{ID: "zot"}, "system:serviceaccount:app-a-ci:app-a-artifact")
+	var oe *oauth2.Error
+	require.ErrorAs(t, err, &oe)
+	require.Equal(t, oauth2.RequestNotSupported, oe.Type)
+}
diff --git a/server/registry/artifact_test.go b/server/registry/artifact_test.go
new file mode 100644
index 0000000..236cdb5
--- /dev/null
+++ b/server/registry/artifact_test.go
@@ -0,0 +1,120 @@
+package registry
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+var testArtifactConfig = ArtifactConfig{Clients: []string{"pathops-artifact-store"}, Connector: "k8s-cell",
+	Issuer: "https://dex.example.org/artifacts", Audience: "pathops-artifact-store", KeyID: "artifact-1"}
+
+func artifactCluster() cluster {
+	c := goodCluster()
+	c["app-a-ci/app-a-artifact"] = map[string]string{LabelApplication: appA, LabelCapability: CapabilityArtifact}
+	return c
+}
+
+func newArtifactIssuer(t *testing.T, c cluster) (*Issuer, ed25519.PublicKey) {
+	t.Helper()
+	pub, key, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	i, err := NewArtifact(testArtifactConfig, key, c.lookup)
+	require.NoError(t, err)
+	return i, pub
+}
+
+func TestArtifactIssue(t *testing.T) {
+	i, pub := newArtifactIssuer(t, artifactCluster())
+	require.Equal(t, ArtifactTokenType, i.TokenType())
+	now := time.Unix(1_800_000_000, 0)
+	i.Now = func() time.Time { return now }
+	tok, exp, err := i.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-artifact")
+	require.NoError(t, err)
+	require.Equal(t, now.Add(5*time.Minute).UTC(), exp)
+	parts := strings.Split(tok, ".")
+	require.Len(t, parts, 3)
+	sig, _ := base64.RawURLEncoding.DecodeString(parts[2])
+	require.True(t, ed25519.Verify(pub, []byte(parts[0]+"."+parts[1]), sig))
+	var header, claims map[string]any
+	raw, _ := base64.RawURLEncoding.DecodeString(parts[0])
+	require.NoError(t, json.Unmarshal(raw, &header))
+	raw, _ = base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, json.Unmarshal(raw, &claims))
+	require.Equal(t, map[string]any{"alg": "EdDSA", "typ": "JWT", "kid": "artifact-1"}, header)
+	require.Equal(t, "https://dex.example.org/artifacts", claims["iss"])
+	require.Equal(t, "pathops-artifact-store", claims["aud"])
+	require.Equal(t, "system:serviceaccount:app-a-ci:app-a-artifact", claims["sub"])
+	require.Equal(t, appA, claims["pathops_application"])
+	require.Equal(t, []any{"read", "write"}, claims["pathops_operations"])
+	require.NotContains(t, claims, "access", "an Artifact Store token is no registry token")
+	require.EqualValues(t, now.Unix()+300, claims["exp"])
+}
+
+// The two kinds of workload identity never stand in for each other.
+func TestArtifactAndRegistryIdentitiesAreDistinct(t *testing.T) {
+	art, _ := newArtifactIssuer(t, artifactCluster())
+	_, _, err := art.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-build")
+	require.ErrorIs(t, err, ErrDenied, "the build ServiceAccount gets no Artifact Store token")
+
+	reg, _ := newTestIssuer(t, artifactCluster())
+	_, _, err = reg.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-artifact")
+	require.ErrorIs(t, err, ErrDenied, "the artifact ServiceAccount gets no registry token")
+
+	// An artifact-named ServiceAccount labeled with the build capability (or
+	// the reverse) is refused too.
+	c := artifactCluster()
+	c["app-a-ci/app-a-artifact"][LabelCapability] = CapabilityBuild
+	art, _ = newArtifactIssuer(t, c)
+	_, _, err = art.Issue(t.Context(), "system:serviceaccount:app-a-ci:app-a-artifact")
+	require.ErrorIs(t, err, ErrDenied)
+}
+
+func TestArtifactIssueDenied(t *testing.T) {
+	for name, tc := range map[string]struct {
+		subject string
+		change  func(cluster)
+	}{
+		"another Application's name": {subject: "system:serviceaccount:app-a-ci:app-b-artifact"},
+		"not a CI namespace":         {subject: "system:serviceaccount:app-a:app-a-artifact"},
+		"default ServiceAccount":     {subject: "system:serviceaccount:app-a-ci:default"},
+		"ServiceAccount of another app": {subject: "system:serviceaccount:app-a-ci:app-a-artifact", change: func(c cluster) {
+			c["app-a-ci/app-a-artifact"][LabelApplication] = "22222222-2222-4222-8222-222222222222"
+		}},
+		"ServiceAccount no capability": {subject: "system:serviceaccount:app-a-ci:app-a-artifact", change: func(c cluster) { delete(c["app-a-ci/app-a-artifact"], LabelCapability) }},
+		"namespace not labeled CI":     {subject: "system:serviceaccount:app-a-ci:app-a-artifact", change: func(c cluster) { c["app-a-ci"][LabelCI] = "false" }},
+		"ServiceAccount missing":       {subject: "system:serviceaccount:app-a-ci:app-a-artifact", change: func(c cluster) { delete(c, "app-a-ci/app-a-artifact") }},
+	} {
+		t.Run(name, func(t *testing.T) {
+			c := artifactCluster()
+			if tc.change != nil {
+				tc.change(c)
+			}
+			i, _ := newArtifactIssuer(t, c)
+			_, _, err := i.Issue(t.Context(), tc.subject)
+			require.ErrorIs(t, err, ErrDenied)
+		})
+	}
+}
+
+func TestNewArtifactValidates(t *testing.T) {
+	_, key, _ := ed25519.GenerateKey(rand.Reader)
+	for name, change := range map[string]func(*ArtifactConfig){
+		"no clients":       func(c *ArtifactConfig) { c.Clients = nil },
+		"no audience":      func(c *ArtifactConfig) { c.Audience = "" },
+		"http issuer":      func(c *ArtifactConfig) { c.Issuer = "http://dex.example.org/artifacts" },
+		"lifetime over 5m": func(c *ArtifactConfig) { c.ValidFor = "10m" },
+	} {
+		c := testArtifactConfig
+		change(&c)
+		_, err := NewArtifact(c, key, goodCluster().lookup)
+		require.Error(t, err, name)
+		require.Contains(t, err.Error(), "artifactTokens.", name)
+	}
+}
