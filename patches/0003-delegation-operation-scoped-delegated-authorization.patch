@@ -0,0 +1,76 @@
+package grants
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+	"time"
+
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/delegation"
+	"github.com/dexidp/dex/server/oauth2"
