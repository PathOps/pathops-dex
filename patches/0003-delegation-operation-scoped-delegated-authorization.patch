+
+// Delegation renders the consent screen of an Authorization Plan.
+func (t *Templates) Delegation(r *http.Request, w http.ResponseWriter, page DelegationPage) error {
+	if t.delegationTmpl == nil {
+		return fmt.Errorf("missing template %s", tmplDelegation)
+	}
+	page.ReqPath = r.URL.Path
+	return renderTemplate(w, t.delegationTmpl, page)
+}
