+func TestDelegationPushedRequestChecks(t *testing.T) {
+	e := newDelegationEnv(t)
+	pk := newPKCE()
+	details := dlgDetails("kilgore", "app-a", "app-id-app-a")
+	good, raw := e.plan("app-a", pk, details, nil)
+
+	_, otherKey, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	field := func(k string, v any) func(map[string]any) {
+		return func(c map[string]any) { c["pathops_plan"].(map[string]any)[k] = v }
+	}
+	claim := func(k string, v any) func(map[string]any) { return func(c map[string]any) { c[k] = v } }
+	withKey := func(k ed25519.PrivateKey, kid string) string {
+		old, oldKid := e.key, e.kid
+		e.key, e.kid = k, kid
+		defer func() { e.key, e.kid = old, oldKid }()
+		p, _ := e.plan("app-a", pk, details, nil)
+		return p
+	}
+	changedRepo := dlgDetails("kilgore", "app-a", "app-id-app-a")
+	changedRepo[0]["repository"] = "app-z"
+	changedAction := dlgDetails("kilgore", "app-a", "app-id-app-a")
+	changedAction[3]["actions"] = []string{"configure", "delete"}
+	extra := append(dlgDetails("kilgore", "app-a", "app-id-app-a"), dlgDetails("kilgore", "app-b", "x")[0])
+
+	cases := map[string]struct {
+		plan, details string
+		pk            dlgPKCE
+		want          string
+	}{
+		"changed repository":   {good, mustJSON(t, changedRepo), pk, "authorization_details differ from the plan"},
+		"changed action":       {good, mustJSON(t, changedAction), pk, "authorization_details differ from the plan"},
+		"added detail":         {good, mustJSON(t, extra), pk, "authorization_details differ from the plan"},
+		"dropped detail":       {good, mustJSON(t, details[:3]), pk, "authorization_details differ from the plan"},
+		"reordered details":    {good, mustJSON(t, []map[string]any{details[1], details[0], details[2], details[3]}), pk, "authorization_details differ from the plan"},
+		"other PKCE challenge": {good, raw, newPKCE(), "code_challenge differs from the plan"},
+		"unknown signing key":  {withKey(otherKey, "plan-1"), raw, pk, "bad signature"},
+		"unknown kid":          {withKey(e.key, "plan-2"), raw, pk, "unknown plan key"},
+		"no plan":              {"", raw, pk, "missing or too large"},
+		"expired plan": {func() string {
+			p, _ := e.plan("app-a", pk, details, func(c map[string]any) {
+				c["iat"], c["exp"] = time.Now().Add(-12*time.Minute).Unix(), time.Now().Add(-2*time.Minute).Unix()
+			})
+			return p
+		}(), raw, pk, "expired"},
+		"plan for another Dex": {func() string { p, _ := e.plan("app-a", pk, details, claim("aud", "https://other.example")); return p }(), raw, pk, "audience is not this issuer"},
+		"subject changed":      {func() string { p, _ := e.plan("app-a", pk, details, claim("sub", "x")); return p }(), raw, pk, "sub is not a subject"},
+		"redirect changed": {func() string {
+			p, _ := e.plan("app-a", pk, details, field("redirect_uri", "http://127.0.0.1:9999/cb"))
+			return p
+		}(), raw, pk, "redirect_uri differs from the plan"},
+		"other client": {func() string { p, _ := e.plan("app-a", pk, details, field("client_id", dlgOther)); return p }(), raw, pk, "client_id may not carry plans"},
+		"digest mismatch": {func() string {
+			p, _ := e.plan("app-a", pk, details, field("authorization_details_sha256", "AAAA"))
+			return p
+		}(), raw, pk, "authorization_details_sha256 does not match"},
+		"plain challenge method": {func() string { p, _ := e.plan("app-a", pk, details, field("code_challenge_method", "plain")); return p }(), raw, pk, "S256 code_challenge is required"},
+		"long-lived plan": {func() string {
+			p, _ := e.plan("app-a", pk, details, claim("exp", time.Now().Add(2*time.Hour).Unix()))
+			return p
+		}(), raw, pk, "lifetime above"},
+		"unknown claim": {func() string { p, _ := e.plan("app-a", pk, details, claim("scope", "all")); return p }(), raw, pk, "unexpected claims"},
+		"application changed": {func() string {
+			p, _ := e.plan("app-a", pk, details, field("application", map[string]any{"id": "x", "name": "app-b"}))
+			return p
+		}(), raw, pk, "application or run"},
+		"run changed": {func() string {
+			p, _ := e.plan("app-a", pk, details, field("run", map[string]any{"id": "nope"}))
+			return p
+		}(), raw, pk, "application or run"},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			rr := e.par(tc.plan, tc.details, tc.pk)
+			require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+			require.Contains(t, rr.Body.String(), tc.want)
+		})
+	}
+
+	// A plan whose fields were changed after signing does not verify.
+	parts := strings.Split(good, ".")
+	var payload map[string]any
+	b, _ := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, json.Unmarshal(b, &payload))
+	payload["pathops_plan"].(map[string]any)["run"] = map[string]any{"id": "44444444-2222-4333-8444-dddddddddddd"}
+	parts[1] = base64.RawURLEncoding.EncodeToString([]byte(mustJSON(t, payload)))
+	rr := e.par(strings.Join(parts, "."), raw, pk)
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Contains(t, rr.Body.String(), "bad signature")
+
+	// The pathops-cli client cannot send details on the front channel.
+	q := url.Values{"client_id": {dlgCLI}, "response_type": {"code"}, "scope": {"openid"}, "redirect_uri": {dlgRedirect},
+		"state": {"s"}, "code_challenge": {pk.challenge}, "code_challenge_method": {"S256"}, "authorization_details": {raw}}
+	rr = e.do(http.MethodGet, "/auth/mock?"+q.Encode(), nil)
+	require.Equal(t, http.StatusSeeOther, rr.Code)
+	require.Contains(t, rr.Header().Get("Location"), "error=invalid_request")
+
+	// A confidential client that is not a plan client cannot push.
+	rr = e.do(http.MethodPost, "/par", url.Values{"client_id": {dlgTCP}, "client_secret": {dlgTCPSecret}})
+	require.Equal(t, "unauthorized_client", errorOf(t, rr))
+
+	// A request_uri starts one flow, before it expires.
+	uri := e.requestURI(good, raw, pk)
+	_, _ = e.consent(uri)
+	q = url.Values{"client_id": {dlgCLI}, "request_uri": {uri}}
+	rr, _ = e.browse("/auth?" + q.Encode())
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Contains(t, rr.Body.String(), "already used")
+
+	uri = e.requestURI(good, raw, pk)
+	*e.clock = e.clock.Add(91 * time.Second)
+	rr, _ = e.browse("/auth?" + url.Values{"client_id": {dlgCLI}, "request_uri": {uri}}.Encode())
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+}
+
+func TestDelegationConsent(t *testing.T) {
+	e := newDelegationEnv(t)
+	pk := newPKCE()
+	details := dlgDetails("kilgore", "app-a", "app-id-app-a")
+
+	// The user rejects: the client gets access_denied and no grant exists.
+	plan, raw := e.plan("app-a", pk, details, nil)
+	_, approval := e.consent(e.requestURI(plan, raw, pk))
+	cb := e.approve(approval, "rejected")
+	require.Equal(t, "access_denied", cb.Query().Get("error"))
+	require.Equal(t, "invalid_grant", errorOf(t, e.derive(delegation.Handle(planID(t, plan), e.subject), dlgAudience, details[:1])))
+
+	// A plan prepared for another user is refused after login.
+	otherSub, err := tokens.GenSubject("someone-else", "mock")
+	require.NoError(t, err)
+	plan, raw = e.plan("app-a", pk, details, func(c map[string]any) { c["sub"] = otherSub })
+	q := url.Values{"client_id": {dlgCLI}, "request_uri": {e.requestURI(plan, raw, pk)}}
+	rr, _ := e.browse("/auth?" + q.Encode())
+	require.Equal(t, http.StatusForbidden, rr.Code)
+	require.Contains(t, rr.Body.String(), "another user")
+
+	// Discovery advertises PAR and the detail types.
+	rr = e.do(http.MethodGet, "/.well-known/openid-configuration", nil)
+	var d map[string]any
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &d))
+	require.Equal(t, e.issuer+"/par", d["pushed_authorization_request_endpoint"])
+	require.Equal(t, []any{"pathops_repository", "pathops_webhook"}, d["authorization_details_types_supported"])
+}
+
+func TestDelegationCanonical(t *testing.T) {
+	for in, want := range map[string]string{
+		`[ {"b":1, "a":"x"} ]`:                `[{"a":"x","b":1}]`,
+		`{"k":["z","a"],"q":"a\"b\\c"}`:       `{"k":["z","a"],"q":"a\"b\\c"}`,
+		`{"n":-12,"t":true,"f":false,"o":{}}`: `{"f":false,"n":-12,"o":{},"t":true}`,
+	} {
+		got, err := delegation.Canonical([]byte(in))
+		require.NoError(t, err, in)
+		require.Equal(t, want, string(got))
+	}
+	for _, bad := range []string{`{"a":1,"a":2}`, `{"a":null}`, `{"a":1.5}`, `{"a":1e3}`, `{"a":"é"}`, `{"a":"\u0001"}`,
+		`[1] [2]`, `{"a":9007199254740992}`, `{"a":-0}`, strings.Repeat("[", 12) + strings.Repeat("]", 12)} {
+		_, err := delegation.Canonical([]byte(bad))
+		require.Error(t, err, bad)
+	}
+}
