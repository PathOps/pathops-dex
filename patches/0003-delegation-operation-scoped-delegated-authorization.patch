+{{ template "header.html" . }}
+
+<div class="theme-panel">
+  <h2 class="theme-heading">Approve an operation</h2>
+
+  <hr class="dex-separator">
+  <div>
+    <div class="dex-subtle-text">
+      <strong>{{ .Delegate }}</strong> asks to act as <strong>{{ .User }}</strong> for this operation only:
+    </div>
+    <p id="pathops-operation"><strong>{{ .Operation }}</strong> &mdash; Application <strong>{{ .Application }}</strong></p>
+    <ul class="dex-list" id="pathops-authorization-details">
+      {{ range $item := .Items }}
+      <li>{{ $item }}</li>
+      {{ end }}
+    </ul>
+    <div class="dex-subtle-text">
+      Template {{ .Template }}. Run {{ .Run }}.
+    </div>
+    <div class="dex-subtle-text">
+      This approval covers only the resources listed above and expires {{ .GrantTTL }} after you approve.
+      Each tool credential derived from it lasts at most {{ .TokenTTL }}, has no refresh token and carries only
+      the part of this list its step needs. Another operation needs another approval.
+    </div>
+    <details>
+      <summary class="dex-subtle-text">Exact authorization details (plan {{ .PlanID }})</summary>
+      <pre id="pathops-authorization-details-json" style="white-space: pre-wrap; word-break: break-all;">{{ .Details }}</pre>
+    </details>
+  </div>
+  <hr class="dex-separator">
+
+  <div>
+    <div class="theme-form-row">
+      <form method="post">
+        <input type="hidden" name="req" value="{{ .AuthReqID }}"/>
+        <input type="hidden" name="approval" value="approve">
+        <button type="submit" id="pathops-approve" class="dex-btn theme-btn--success">
+            <span class="dex-btn-text">Approve</span>
+        </button>
+      </form>
+    </div>
+    <div class="theme-form-row">
+      <form method="post">
+        <input type="hidden" name="req" value="{{ .AuthReqID }}"/>
+        <input type="hidden" name="approval" value="rejected">
+        <button type="submit" id="pathops-reject" class="dex-btn theme-btn-provider">
+            <span class="dex-btn-text">Reject</span>
+        </button>
+      </form>
+    </div>
+  </div>
+
+</div>
+
+{{ template "footer.html" . }}
