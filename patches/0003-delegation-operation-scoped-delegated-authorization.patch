diff --git a/server/authflow/par.go b/server/authflow/par.go
new file mode 100644
index 0000000..9d2624d
--- /dev/null
+++ b/server/authflow/par.go
@@ -0,0 +1,123 @@
+package authflow
+
+// par.go is the pushed authorization request endpoint (RFC 9126) of PathOps
+// delegation: the public client pushes an authorization request carrying RAR
+// authorization_details and the delegate's signed Authorization Plan, and gets
+// a short-lived, single-use request_uri for the browser.
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"slices"
+
+	"github.com/dexidp/dex/server/delegation"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/storage"
+)
+
+func (h *Handler) handlePAR(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	fail := func(status int, typ, description string) {
+		oauth2.WriteErrorResponse(h.Logger, w, typ, description, status)
+	}
+	if r.Method != http.MethodPost {
+		fail(http.StatusMethodNotAllowed, oauth2.InvalidRequest, "method not allowed")
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 256<<10)
+	if err := r.ParseForm(); err != nil {
+		fail(http.StatusBadRequest, oauth2.InvalidRequest, "the request body is not a form")
+		return
+	}
+	form := r.PostForm
+	if form.Get("request_uri") != "" {
+		fail(http.StatusBadRequest, oauth2.InvalidRequest, "request_uri is not allowed in a pushed authorization request")
+		return
+	}
+
+	// Client authentication: a public client only names itself; a
+	// confidential client must present its secret.
+	clientID, secret := form.Get("client_id"), form.Get("client_secret")
+	if id, s, ok := r.BasicAuth(); ok {
+		var err error
+		if clientID, err = url.QueryUnescape(id); err != nil {
+			fail(http.StatusBadRequest, oauth2.InvalidRequest, "client_id improperly encoded")
+			return
+		}
+		if secret, err = url.QueryUnescape(s); err != nil {
+			fail(http.StatusBadRequest, oauth2.InvalidRequest, "client_secret improperly encoded")
+			return
+		}
+	}
+	client, err := h.Storage.GetClient(ctx, clientID)
+	if err != nil {
+		if err != storage.ErrNotFound {
+			h.Logger.ErrorContext(ctx, "failed to get client", "err", err)
+			fail(http.StatusInternalServerError, oauth2.ServerError, "")
+			return
+		}
+		fail(http.StatusUnauthorized, oauth2.InvalidClient, "Invalid client credentials.")
+		return
+	}
+	if !client.Public && subtle.ConstantTimeCompare([]byte(client.Secret), []byte(secret)) != 1 {
+		fail(http.StatusUnauthorized, oauth2.InvalidClient, "Invalid client credentials.")
+		return
+	}
+	if !h.Delegation.PlanClient(client.ID) {
+		fail(http.StatusBadRequest, "unauthorized_client", "this client may not push authorization requests")
+		return
+	}
+	form.Set("client_id", client.ID)
+
+	authReq, _, err := h.parseAuthorizationParams(ctx, form, true)
+	if err != nil {
+		switch e := err.(type) {
+		case *redirectedAuthErr:
+			fail(http.StatusBadRequest, e.Type, e.Description)
+		case *displayedAuthErr:
+			fail(http.StatusBadRequest, oauth2.InvalidRequest, e.Description)
+		default:
+			fail(http.StatusInternalServerError, oauth2.ServerError, "")
+		}
+		return
+	}
+	if !slices.Equal(authReq.ResponseTypes, []string{oauth2.ResponseTypeCode}) {
+		fail(http.StatusBadRequest, oauth2.InvalidRequest, "an authorization plan requires response_type=code")
+		return
+	}
+	plan, err := h.Delegation.VerifyPlan(form.Get(delegation.PlanParam), h.IssuerURL.String(), h.Now())
+	if err != nil {
+		h.Logger.InfoContext(ctx, "pushed authorization request refused", "client_id", client.ID, "err", err)
+		fail(http.StatusBadRequest, oauth2.InvalidRequest, err.Error())
+		return
+	}
+	if err := plan.MatchPushed(authReq.ClientID, authReq.RedirectURI, authReq.PKCE.CodeChallenge,
+		authReq.PKCE.CodeChallengeMethod, form.Get(delegation.DetailsParam)); err != nil {
+		h.Logger.InfoContext(ctx, "pushed authorization request refused", "client_id", client.ID, "plan", plan.ID, "err", err)
+		fail(http.StatusBadRequest, "invalid_authorization_details", err.Error())
+		return
+	}
+
+	authReq.Delegation = (&delegation.Request{Pushed: true, Plan: *plan}).Encode()
+	authReq.ForceApprovalPrompt = true
+	ttl := h.Delegation.PushedRequestsValidFor()
+	authReq.Expiry = h.Now().Add(ttl)
+	if err := h.Storage.CreateAuthRequest(ctx, *authReq); err != nil {
+		h.Logger.ErrorContext(ctx, "failed to store pushed authorization request", "err", err)
+		fail(http.StatusInternalServerError, oauth2.ServerError, "")
+		return
+	}
+	h.Logger.InfoContext(ctx, "pushed authorization request accepted", "client_id", client.ID, "plan", plan.ID,
+		"delegate", plan.Delegate, "operation", plan.Operation, "application", plan.Application.Name, "run", plan.Run.ID)
+
+	body, _ := json.Marshal(struct {
+		RequestURI string `json:"request_uri"`
+		ExpiresIn  int    `json:"expires_in"`
+	}{delegation.RequestURIPrefix + authReq.ID, int(ttl.Seconds())})
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(http.StatusCreated)
+	w.Write(body)
+}
