+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/storage"
+)
+
+// delegatedGrantType is the internal key of the PathOps delegated derivation:
+// an RFC 8693 token exchange whose subject_token is an operation grant handle
+// (subject_token_type delegation.OperationGrantTokenType).
+const delegatedGrantType = "pathops:delegated-derivation"
+
+// delegatedExchange derives a short-lived tool token from an operation grant
+// for its delegate, an authenticated confidential client. The subject is the
+// grant the user approved, never a user token.
+type delegatedExchange struct {
+	policy  *delegation.Policy
+	storage storage.Storage
+	signer  signer.Signer
+	issuer  string
+	now     func() time.Time
+	logger  *slog.Logger
+}
+
+func (g *delegatedExchange) GrantType() string { return delegatedGrantType }
+
+func (g *delegatedExchange) RequiresClientAuth() bool { return true }
+
+// ScopePolicy passes scopes through: a derived token carries
+// authorization_details, not scopes, and ignores any scope parameter.
+func (g *delegatedExchange) ScopePolicy() ScopePolicy { return ScopePolicy{} }
+
+func (g *delegatedExchange) ConnectorID(context.Context, *Request, storage.Client) (string, *oauth2.Error) {
+	return "", nil
+}
+
+func (g *delegatedExchange) Authorize(ctx context.Context, req *Request, client storage.Client, _ connectors.Connector) (Responder, error) {
+	if client.Public || !g.policy.Delegate(client.ID) {
+		g.logger.InfoContext(ctx, "delegated derivation refused: not a delegate", "client_id", client.ID)
+		return nil, &oauth2.Error{Type: "unauthorized_client", Description: "only an authenticated delegate may derive delegated tokens",
+			Status: http.StatusBadRequest}
+	}
+	if req.RequestedTokenType != "" && req.RequestedTokenType != oauth2.TokenTypeAccess {
+		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "requested_token_type must be an access token", Status: http.StatusBadRequest}
+	}
+	now := g.now()
+	d, err := g.policy.Derive(ctx, g.storage, g.signer, g.issuer, client.ID, req.SubjectToken, req.Audience, req.AuthorizationDetails, now)
+	var derr *delegation.DeriveError
+	if errors.As(err, &derr) {
+		g.logger.InfoContext(ctx, "delegated derivation refused", "client_id", client.ID, "error", derr.Type, "reason", derr.Description)
+		return nil, &oauth2.Error{Type: derr.Type, Description: derr.Description, Status: http.StatusBadRequest}
+	}
+	if err != nil {
+		g.logger.ErrorContext(ctx, "delegated derivation failed", "client_id", client.ID, "err", err)
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	g.logger.InfoContext(ctx, "delegated token issued", "client_id", client.ID, "audience", d.Audience,
+		"expires_at", d.Expiry.Format(time.RFC3339))
+	return tokens.Response{
+		AccessToken:          d.Token,
+		IssuedTokenType:      oauth2.TokenTypeAccess,
+		TokenType:            "bearer",
+		ExpiresIn:            int(d.Expiry.Sub(now).Seconds()),
+		AuthorizationDetails: d.Details,
+	}, nil
+}
