+package kubernetes
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// The PathOps delegation state survives the Kubernetes representation of
+// auth requests and auth codes.
+func TestDelegationFieldRoundTrip(t *testing.T) {
+	cli := &client{apiVersion: "dex.coreos.com/v1", namespace: "identity"}
+	state := []byte(`{"plan":{"id":"plan-1"}}`)
+
+	req := cli.fromStorageAuthRequest(storage.AuthRequest{ID: "req", ClientID: "c", Delegation: state})
+	require.Equal(t, state, toStorageAuthRequest(req).Delegation)
+
+	code := cli.fromStorageAuthCode(storage.AuthCode{ID: "code", ClientID: "c", Delegation: state})
+	require.Equal(t, state, toStorageAuthCode(code).Delegation)
+
+	require.Nil(t, toStorageAuthRequest(cli.fromStorageAuthRequest(storage.AuthRequest{ID: "plain"})).Delegation)
+}
