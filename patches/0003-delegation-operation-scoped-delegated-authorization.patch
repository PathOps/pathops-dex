 	case http.MethodGet:
 		// The dispatcher routes here only when consent is required, so just show
@@ -143,3 +156,78 @@ func scopesCoveredByConsent(approved, requested []string) bool {
 
 	return true
 }
+
+// handleDelegationApproval shows a PathOps Authorization Plan (GET) and, on
+// approval (POST), records the operation grant. The grant becomes usable only
+// when the client redeems the authorization code with the plan's PKCE
+// verifier. A refusal returns access_denied to the client.
+func (h *Handler) handleDelegationApproval(w http.ResponseWriter, r *http.Request, authReq storage.AuthRequest) {
+	ctx := r.Context()
+	now := time.Now
+	if h.Now != nil {
+		now = h.Now
+	}
+	d, err := delegation.CheckAuthRequest(authReq, now())
+	if err != nil || d == nil || h.Delegation == nil {
+		msg := "Invalid authorization request."
+		if err != nil {
+			msg = err.Error()
+		}
+		h.renderError(r, w, http.StatusForbidden, msg)
+		return
+	}
+	plan := d.Plan
+	switch r.Method {
+	case http.MethodGet:
+		page := templates.DelegationPage{
+			AuthReqID:   authReq.ID,
+			User:        authReq.Claims.Email,
+			Delegate:    h.Delegation.DelegateName(plan.Delegate),
+			Operation:   plan.Operation,
+			Application: plan.Application.Name,
+			Run:         plan.Run.ID,
+			Template:    plan.Template.ID + " (" + plan.Template.Source + " @ " + plan.Template.Ref + ")",
+			Items:       h.Delegation.Describe(&plan),
+			Details:     string(plan.Details),
+			GrantTTL:    h.Delegation.GrantsValidFor().String(),
+			TokenTTL:    h.Delegation.TokensValidFor().String(),
+			PlanID:      plan.ID,
+		}
+		if err := h.Templates.Delegation(r, w, page); err != nil {
+			h.Logger.ErrorContext(ctx, "server template error", "err", err)
+		}
+	case http.MethodPost:
+		if r.FormValue("approval") != "approve" {
+			h.Logger.InfoContext(ctx, "authorization plan rejected by the user", "plan", plan.ID, "client_id", authReq.ClientID)
+			if err := h.Storage.DeleteAuthRequest(ctx, authReq.ID); err != nil && err != storage.ErrNotFound {
+				h.Logger.ErrorContext(ctx, "failed to delete auth request", "err", err)
+			}
+			u, err := url.Parse(authReq.RedirectURI)
+			if err != nil {
+				h.renderError(r, w, http.StatusBadRequest, "Approval rejected.")
+				return
+			}
+			q := u.Query()
+			q.Set("error", oauth2.AccessDenied)
+			q.Set("error_description", "The user rejected the operation.")
+			if authReq.State != "" {
+				q.Set("state", authReq.State)
+			}
+			u.RawQuery = q.Encode()
+			http.Redirect(w, r, u.String(), http.StatusSeeOther)
+			return
+		}
+		g, err := h.Delegation.Approve(ctx, h.Storage, &plan, authReq.Claims, now())
+		if err != nil {
+			h.Logger.ErrorContext(ctx, "failed to record operation grant", "plan", plan.ID, "err", err)
+			h.renderError(r, w, http.StatusInternalServerError, "Failed to record the approval.")
+			return
+		}
+		h.Logger.InfoContext(ctx, "operation grant approved", "plan", plan.ID, "delegate", plan.Delegate,
+			"operation", plan.Operation, "application", plan.Application.Name, "run", plan.Run.ID,
+			"expires_at", g.ExpiresAt.Format(time.RFC3339))
+		http.Redirect(w, r, h.buildApprovedURL(authReq), http.StatusSeeOther)
+	default:
+		h.renderError(r, w, http.StatusBadRequest, "Unsupported request method.")
+	}
+}
diff --git a/server/delegation/canonical.go b/server/delegation/canonical.go
new file mode 100644
index 0000000..5fad134
--- /dev/null
+++ b/server/delegation/canonical.go
@@ -0,0 +1,171 @@
+package delegation
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// Canonical JSON, PathOps v1: the byte form the TCP signs over and Dex,
+// the CLI and resource servers compare. It is RFC 8785 (JCS) restricted to a
+// subset where every encoder agrees byte for byte:
+//
+//   - objects (members sorted by key, no duplicate keys), arrays, strings,
+//     booleans and integers;
+//   - strings and keys of printable ASCII only (0x20-0x7E), escaping exactly
+//     '"' and '\';
+//   - integers within ±(2^53-1), written without sign for zero, exponent or
+//     fraction;
+//   - no null, no whitespace, at most maxDepth levels and maxCanonicalSize
+//     bytes.
+//
+// Input outside the subset is rejected, never normalized, so two parties can
+// only agree on bytes they both accepted.
+const (
+	maxCanonicalSize = 64 << 10
+	maxDepth         = 8
+)
+
+var errNotCanonical = errors.New("not PathOps canonical JSON")
+
+// Canonical returns the canonical form of raw (any JSON value).
+func Canonical(raw []byte) ([]byte, error) {
+	if len(raw) > maxCanonicalSize {
+		return nil, fmt.Errorf("%w: larger than %d bytes", errNotCanonical, maxCanonicalSize)
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	var out bytes.Buffer
+	if err := canonicalValue(dec, &out, 0); err != nil {
+		return nil, err
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return nil, fmt.Errorf("%w: trailing data", errNotCanonical)
+	}
+	return out.Bytes(), nil
+}
+
+// DigestOf is the base64url (unpadded) SHA-256 of canonical bytes.
+func DigestOf(canonical []byte) string {
+	sum := sha256.Sum256(canonical)
+	return base64.RawURLEncoding.EncodeToString(sum[:])
+}
+
+func canonicalValue(dec *json.Decoder, out *bytes.Buffer, depth int) error {
+	if depth > maxDepth {
+		return fmt.Errorf("%w: nested deeper than %d", errNotCanonical, maxDepth)
+	}
+	tok, err := dec.Token()
+	if err != nil {
+		return fmt.Errorf("%w: %v", errNotCanonical, err)
+	}
+	switch v := tok.(type) {
+	case json.Delim:
+		switch v {
+		case '{':
+			return canonicalObject(dec, out, depth)
+		case '[':
+			out.WriteByte('[')
+			for i := 0; dec.More(); i++ {
+				if i > 0 {
+					out.WriteByte(',')
+				}
+				if err := canonicalValue(dec, out, depth+1); err != nil {
+					return err
+				}
+			}
+			if _, err := dec.Token(); err != nil {
+				return fmt.Errorf("%w: %v", errNotCanonical, err)
+			}
+			out.WriteByte(']')
+			return nil
+		}
+		return fmt.Errorf("%w: unexpected %q", errNotCanonical, v)
+	case string:
+		return writeString(out, v)
+	case bool:
+		out.WriteString(strconv.FormatBool(v))
+		return nil
+	case json.Number:
+		s := v.String()
+		if strings.ContainsAny(s, ".eE") || s == "-0" {
+			return fmt.Errorf("%w: number %s is not an integer", errNotCanonical, s)
+		}
+		n, err := strconv.ParseInt(s, 10, 64)
+		if err != nil || n > 1<<53-1 || n < -(1<<53-1) {
+			return fmt.Errorf("%w: integer %s out of range", errNotCanonical, s)
+		}
+		out.WriteString(strconv.FormatInt(n, 10))
+		return nil
+	case nil:
+		return fmt.Errorf("%w: null", errNotCanonical)
+	}
+	return fmt.Errorf("%w: unexpected token %v", errNotCanonical, tok)
+}
+
+func canonicalObject(dec *json.Decoder, out *bytes.Buffer, depth int) error {
+	members := map[string][]byte{}
+	for dec.More() {
+		tok, err := dec.Token()
+		if err != nil {
+			return fmt.Errorf("%w: %v", errNotCanonical, err)
+		}
+		key, ok := tok.(string)
+		if !ok {
+			return fmt.Errorf("%w: object key %v", errNotCanonical, tok)
+		}
+		if _, dup := members[key]; dup {
+			return fmt.Errorf("%w: duplicate key %q", errNotCanonical, key)
+		}
+		var v bytes.Buffer
+		if err := canonicalValue(dec, &v, depth+1); err != nil {
+			return err
+		}
+		members[key] = v.Bytes()
+	}
+	if _, err := dec.Token(); err != nil {
+		return fmt.Errorf("%w: %v", errNotCanonical, err)
+	}
+	keys := make([]string, 0, len(members))
+	for k := range members {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys) // ASCII keys: byte order is UTF-16 code unit order (JCS)
+	out.WriteByte('{')
+	for i, k := range keys {
+		if i > 0 {
+			out.WriteByte(',')
+		}
+		if err := writeString(out, k); err != nil {
+			return err
+		}
+		out.WriteByte(':')
+		out.Write(members[k])
+	}
+	out.WriteByte('}')
+	return nil
+}
+
+func writeString(out *bytes.Buffer, s string) error {
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c < 0x20 || c > 0x7e {
+			return fmt.Errorf("%w: string %q is not printable ASCII", errNotCanonical, s)
+		}
+	}
+	out.WriteByte('"')
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c == '"' || c == '\\' {
+			out.WriteByte('\\')
+		}
+		out.WriteByte(s[i])
+	}
+	out.WriteByte('"')
+	return nil
+}
diff --git a/server/delegation/delegation.go b/server/delegation/delegation.go
new file mode 100644
index 0000000..221d3d7
--- /dev/null
+++ b/server/delegation/delegation.go
@@ -0,0 +1,291 @@
+// Package delegation is the PathOps extension for operation-scoped human
+// delegated authorization (PathOps Decision 0050).
+//
+// A delegate is a confidential client (the PathOps Tenant Control Plane) that
+// computes, for one user operation, an Authorization Plan: the exact RAR
+// (RFC 9396) authorization_details the operation needs, bound to the user,
+// the operation and its Application/Run, the public OAuth client that will
+// carry it, its redirect URI and PKCE challenge. The delegate signs the plan
+// with an Ed25519 key registered here. The public client pushes the plan and
+// the same authorization_details to Dex with a standard Pushed Authorization
+// Request (RFC 9126) and continues with Authorization Code + PKCE:
+//
+//	CLI --PAR(authorization_details, signed plan, PKCE challenge)--> Dex
+//	Dex --request_uri--> CLI --> browser --> login --> per-operation consent
+//	CLI --code + PKCE verifier--> Dex: the operation grant becomes active
+//	delegate --client auth + operation grant + detail subset--> Dex
+//	Dex --short-lived token: aud=<tool audience>, exact details--> delegate
+//
+// Dex accepts a plan only when its signature verifies with a key of its
+// issuer, and the pushed authorization_details are exactly (canonical JSON)
+// the plan's. The consent screen shows the plan. Approval records an operation
+// grant for the user; redeeming the authorization code with the plan's PKCE
+// verifier activates it. Only the plan's delegate, authenticated as a
+// confidential client, can then derive tool tokens from it: one audience, a
+// subset of the approved details, a short lifetime and no refresh token. The
+// user's own access tokens never take part in the derivation.
+//
+// Grants live in the user's storage.UserIdentity (Consents map, reserved key
+// prefix), so no storage schema changes; the in-flight plan rides on the
+// AuthRequest/AuthCode Delegation field. Delegation requires a storage that
+// keeps that field (kubernetes, memory).
+package delegation
+
+import (
+	"crypto/ed25519"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"regexp"
+	"slices"
+	"time"
+)
+
+// Wire names.
+const (
+	// PlanParam carries the signed plan in the pushed authorization request.
+	PlanParam = "pathops_authorization_plan"
+	// DetailsParam is the RFC 9396 parameter.
+	DetailsParam = "authorization_details"
+	// RequestURIPrefix prefixes every request_uri (RFC 9126 §2.2).
+	RequestURIPrefix = "urn:ietf:params:oauth:request_uri:"
+	// OperationGrantTokenType is the RFC 8693 subject_token_type of an
+	// operation grant handle.
+	OperationGrantTokenType = "urn:pathops:params:oauth:token-type:operation-grant"
+	// PlanTokenType is the JWS "typ" of a signed plan.
+	PlanTokenType = "pathops-authorization-plan+jwt"
+	// PlanVersion is the plan schema this Dex accepts.
+	PlanVersion = 1
+)
+
+// Config is the "delegation" section of the Dex configuration.
+type Config struct {
+	// PlanClients are the public OAuth clients that may push plans (PAR).
+	PlanClients []string `json:"planClients"`
+	// PushedRequestsValidFor bounds a request_uri (default 90s).
+	PushedRequestsValidFor string `json:"pushedRequestsValidFor"`
+	// MaxPlanLifetime bounds exp-iat of a plan (default 15m).
+	MaxPlanLifetime string `json:"maxPlanLifetime"`
+	// GrantsValidFor is an operation grant's lifetime from approval (default 15m).
+	GrantsValidFor string `json:"grantsValidFor"`
+	// TokensValidFor bounds a derived tool token (default 5m).
+	TokensValidFor string `json:"tokensValidFor"`
+	// Delegates are the confidential clients that sign plans and derive tool
+	// tokens from the resulting grants.
+	Delegates []DelegateConfig `json:"delegates"`
+}
+
+// DelegateConfig is one delegate.
+type DelegateConfig struct {
+	// Client is the delegate's (confidential) static client id.
+	Client string `json:"client"`
+	// Name is shown on the consent screen.
+	Name string `json:"name"`
+	// PlanIssuer is the "iss" of the delegate's plans.
+	PlanIssuer string `json:"planIssuer"`
+	// PlanKeys verify the delegate's plans.
+	PlanKeys []KeyConfig `json:"planKeys"`
+	// Tools are the audiences the delegate may derive tokens for.
+	Tools []ToolConfig `json:"tools"`
+}
+
+// KeyConfig is an Ed25519 plan-signing public key.
+type KeyConfig struct {
+	KeyID string `json:"kid"`
+	// Ed25519 is the raw 32-byte public key, base64url (a JWK OKP "x").
+	Ed25519 string `json:"ed25519"`
+}
+
+// ToolConfig is a resource server the delegate may derive tokens for.
+type ToolConfig struct {
+	// Name is the "tool" of its authorization details (e.g. forgejo).
+	Name string `json:"name"`
+	// DisplayName is shown on the consent screen (default Name).
+	DisplayName string `json:"displayName"`
+	// AudiencePattern is a regular expression a plan's audience for this tool
+	// must match entirely.
+	AudiencePattern string `json:"audiencePattern"`
+	// DetailTypes are the authorization detail types of this tool.
+	DetailTypes []string `json:"detailTypes"`
+}
+
+// Policy is the validated configuration.
+type Policy struct {
+	planClients     map[string]bool
+	pushedTTL       time.Duration
+	maxPlanLifetime time.Duration
+	grantTTL        time.Duration
+	tokenTTL        time.Duration
+	delegates       map[string]*delegate // by client id
+	byIssuer        map[string]*delegate // by plan issuer
+}
+
+type delegate struct {
+	client, name, issuer string
+	keys                 map[string]ed25519.PublicKey
+	tools                map[string]*tool
+}
+
+type tool struct {
+	name, display string
+	audience      *regexp.Regexp
+	types         map[string]bool
+}
+
+var identifier = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+
+// NewPolicy validates c.
+func NewPolicy(c Config) (*Policy, error) {
+	p := &Policy{
+		planClients: map[string]bool{},
+		delegates:   map[string]*delegate{},
+		byIssuer:    map[string]*delegate{},
+	}
+	var err error
+	durations := []struct {
+		name  string
+		value string
+		def   time.Duration
+		max   time.Duration
+		into  *time.Duration
+	}{
+		{"pushedRequestsValidFor", c.PushedRequestsValidFor, 90 * time.Second, 10 * time.Minute, &p.pushedTTL},
+		{"maxPlanLifetime", c.MaxPlanLifetime, 15 * time.Minute, time.Hour, &p.maxPlanLifetime},
+		{"grantsValidFor", c.GrantsValidFor, 15 * time.Minute, 24 * time.Hour, &p.grantTTL},
+		{"tokensValidFor", c.TokensValidFor, 5 * time.Minute, 15 * time.Minute, &p.tokenTTL},
+	}
+	for _, d := range durations {
+		*d.into = d.def
+		if d.value != "" {
+			if *d.into, err = time.ParseDuration(d.value); err != nil {
+				return nil, fmt.Errorf("delegation.%s: %v", d.name, err)
+			}
+		}
+		if *d.into <= 0 || *d.into > d.max {
+			return nil, fmt.Errorf("delegation.%s must be positive and at most %s", d.name, d.max)
+		}
+	}
+	if p.tokenTTL > p.grantTTL {
+		return nil, errors.New("delegation.tokensValidFor must not exceed grantsValidFor")
+	}
+	if len(c.PlanClients) == 0 {
+		return nil, errors.New("delegation.planClients is empty")
+	}
+	for _, id := range c.PlanClients {
+		if !identifier.MatchString(id) {
+			return nil, fmt.Errorf("delegation.planClients: %q is not a client id", id)
+		}
+		p.planClients[id] = true
+	}
+	if len(c.Delegates) == 0 {
+		return nil, errors.New("delegation.delegates is empty")
+	}
+	for _, dc := range c.Delegates {
+		d, err := newDelegate(dc)
+		if err != nil {
+			return nil, err
+		}
+		if p.planClients[d.client] {
+			return nil, fmt.Errorf("delegation: %q cannot be both a plan client and a delegate", d.client)
+		}
+		if p.delegates[d.client] != nil || p.byIssuer[d.issuer] != nil {
+			return nil, fmt.Errorf("delegation: delegate %q or plan issuer %q is configured twice", d.client, d.issuer)
+		}
+		p.delegates[d.client] = d
+		p.byIssuer[d.issuer] = d
+	}
+	return p, nil
+}
+
+func newDelegate(c DelegateConfig) (*delegate, error) {
+	if !identifier.MatchString(c.Client) {
+		return nil, fmt.Errorf("delegation.delegates: %q is not a client id", c.Client)
+	}
+	d := &delegate{client: c.Client, name: c.Name, issuer: c.PlanIssuer,
+		keys: map[string]ed25519.PublicKey{}, tools: map[string]*tool{}}
+	if d.name == "" {
+		d.name = c.Client
+	}
+	if d.issuer == "" {
+		return nil, fmt.Errorf("delegation.delegates[%s].planIssuer is empty", c.Client)
+	}
+	if len(c.PlanKeys) == 0 {
+		return nil, fmt.Errorf("delegation.delegates[%s].planKeys is empty", c.Client)
+	}
+	for _, k := range c.PlanKeys {
+		raw, err := base64.RawURLEncoding.DecodeString(k.Ed25519)
+		if !identifier.MatchString(k.KeyID) || err != nil || len(raw) != ed25519.PublicKeySize {
+			return nil, fmt.Errorf("delegation.delegates[%s].planKeys: kid %q needs a base64url 32-byte Ed25519 key", c.Client, k.KeyID)
+		}
+		if _, dup := d.keys[k.KeyID]; dup {
+			return nil, fmt.Errorf("delegation.delegates[%s].planKeys: kid %q twice", c.Client, k.KeyID)
+		}
+		d.keys[k.KeyID] = ed25519.PublicKey(raw)
+	}
+	if len(c.Tools) == 0 {
+		return nil, fmt.Errorf("delegation.delegates[%s].tools is empty", c.Client)
+	}
+	for _, tc := range c.Tools {
+		if !identifier.MatchString(tc.Name) || d.tools[tc.Name] != nil {
+			return nil, fmt.Errorf("delegation.delegates[%s].tools: invalid or repeated name %q", c.Client, tc.Name)
+		}
+		re, err := regexp.Compile(`^(?:` + tc.AudiencePattern + `)$`)
+		if tc.AudiencePattern == "" || err != nil {
+			return nil, fmt.Errorf("delegation.delegates[%s].tools[%s].audiencePattern: %v", c.Client, tc.Name, err)
+		}
+		t := &tool{name: tc.Name, display: tc.DisplayName, audience: re, types: map[string]bool{}}
+		if t.display == "" {
+			t.display = tc.Name
+		}
+		if len(tc.DetailTypes) == 0 {
+			return nil, fmt.Errorf("delegation.delegates[%s].tools[%s].detailTypes is empty", c.Client, tc.Name)
+		}
+		for _, typ := range tc.DetailTypes {
+			if !identifier.MatchString(typ) {
+				return nil, fmt.Errorf("delegation.delegates[%s].tools[%s]: %q is not a detail type", c.Client, tc.Name, typ)
+			}
+			t.types[typ] = true
+		}
+		d.tools[tc.Name] = t
+	}
+	return d, nil
+}
+
+// PlanClient reports whether clientID may push plans.
+func (p *Policy) PlanClient(clientID string) bool { return p.planClients[clientID] }
+
+// Delegate reports whether clientID is a delegate.
+func (p *Policy) Delegate(clientID string) bool { return p.delegates[clientID] != nil }
+
+// PushedRequestsValidFor is the lifetime of a request_uri.
+func (p *Policy) PushedRequestsValidFor() time.Duration { return p.pushedTTL }
+
+// DetailTypes are every configured authorization detail type (discovery).
+func (p *Policy) DetailTypes() []string {
+	var out []string
+	for _, d := range p.delegates {
+		for _, t := range d.tools {
+			for typ := range t.types {
+				if !slices.Contains(out, typ) {
+					out = append(out, typ)
+				}
+			}
+		}
+	}
+	slices.Sort(out)
+	return out
+}
+
+// DelegateName is the consent-screen name of a delegate.
+func (p *Policy) DelegateName(clientID string) string {
+	if d := p.delegates[clientID]; d != nil {
+		return d.name
+	}
+	return clientID
+}
+
+// GrantsValidFor is an operation grant's lifetime from approval.
+func (p *Policy) GrantsValidFor() time.Duration { return p.grantTTL }
+
+// TokensValidFor bounds a derived tool token.
+func (p *Policy) TokensValidFor() time.Duration { return p.tokenTTL }
diff --git a/server/delegation/delegation_test.go b/server/delegation/delegation_test.go
new file mode 100644
index 0000000..3fdb2a4
--- /dev/null
+++ b/server/delegation/delegation_test.go
@@ -0,0 +1,60 @@
+package delegation
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func validConfig() Config {
+	return Config{
+		PlanClients: []string{"pathops-cli"},
+		Delegates: []DelegateConfig{{
+			Client: "pathops-tenant-control-plane", PlanIssuer: "https://tcp.example",
+			PlanKeys: []KeyConfig{{KeyID: "k1", Ed25519: base64.RawURLEncoding.EncodeToString(make([]byte, 32))}},
+			Tools:    []ToolConfig{{Name: "forgejo", AudiencePattern: `u:[0-9]+:[0-9a-f-]{36}`, DetailTypes: []string{"pathops_repository"}}},
+		}},
+	}
+}
+
+func TestNewPolicy(t *testing.T) {
+	p, err := NewPolicy(validConfig())
+	require.NoError(t, err)
+	require.Equal(t, "15m0s", p.GrantsValidFor().String())
+	require.Equal(t, "5m0s", p.TokensValidFor().String())
+	require.True(t, p.PlanClient("pathops-cli"))
+	require.True(t, p.Delegate("pathops-tenant-control-plane"))
+	require.False(t, p.Delegate("pathops-cli"))
+
+	for name, mod := range map[string]func(*Config){
+		"no plan clients":         func(c *Config) { c.PlanClients = nil },
+		"no delegates":            func(c *Config) { c.Delegates = nil },
+		"delegate is plan client": func(c *Config) { c.PlanClients = []string{"pathops-tenant-control-plane"} },
+		"short key":               func(c *Config) { c.Delegates[0].PlanKeys[0].Ed25519 = "AAAA" },
+		"no issuer":               func(c *Config) { c.Delegates[0].PlanIssuer = "" },
+		"no tools":                func(c *Config) { c.Delegates[0].Tools = nil },
+		"no audience pattern":     func(c *Config) { c.Delegates[0].Tools[0].AudiencePattern = "" },
+		"no detail types":         func(c *Config) { c.Delegates[0].Tools[0].DetailTypes = nil },
+		"token outlives grant":    func(c *Config) { c.GrantsValidFor, c.TokensValidFor = "1m", "5m" },
+		"grant over a day":        func(c *Config) { c.GrantsValidFor = "48h" },
+		"bad duration":            func(c *Config) { c.TokensValidFor = "soon" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			c := validConfig()
+			mod(&c)
+			_, err := NewPolicy(c)
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestAudiencePatternIsAnchored(t *testing.T) {
+	p, err := NewPolicy(validConfig())
+	require.NoError(t, err)
+	re := p.delegates["pathops-tenant-control-plane"].tools["forgejo"].audience
+	require.True(t, re.MatchString("u:7:2f0c6a51-8d7e-4b8e-9c55-3a2f0e9b1c44"))
+	require.False(t, re.MatchString("x u:7:2f0c6a51-8d7e-4b8e-9c55-3a2f0e9b1c44"))
+	require.False(t, re.MatchString("u:7:2f0c6a51-8d7e-4b8e-9c55-3a2f0e9b1c44"+strings.Repeat("0", 1)))
+}
diff --git a/server/delegation/derive.go b/server/delegation/derive.go
new file mode 100644
index 0000000..aab48ea
--- /dev/null
+++ b/server/delegation/derive.go
@@ -0,0 +1,84 @@
+package delegation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/storage"
+)
+
+// Derived is a tool token derived from an operation grant.
+type Derived struct {
+	Token    string
+	Expiry   time.Time
+	Audience string
+	// Details are the token's authorization_details (canonical).
+	Details json.RawMessage
+}
+
+// DeriveError is a derivation the delegate is refused; Type is the OAuth2
+// error code (invalid_grant, invalid_target, invalid_authorization_details).
+type DeriveError struct {
+	Type        string
+	Description string
+}
+
+func (e *DeriveError) Error() string { return e.Type + ": " + e.Description }
+
+// Derive mints, for the authenticated delegate, a token for one tool audience
+// carrying a subset of an active operation grant's details. The token lives
+// at most tokensValidFor and never beyond the grant; there is no refresh
+// token. Nothing of the user's own tokens is involved: the grant handle names
+// a grant the user approved and completed.
+func (p *Policy) Derive(ctx context.Context, s storage.Storage, sig signer.Signer, issuer, delegateID, handle, audience, details string,
+	now time.Time) (*Derived, error) {
+	if p.delegates[delegateID] == nil {
+		return nil, &DeriveError{Type: "unauthorized_client", Description: "the client is not a delegate"}
+	}
+	g, err := p.load(ctx, s, handle, delegateID, now)
+	switch {
+	case errors.Is(err, ErrGrantNotFound), errors.Is(err, ErrGrantInactive), errors.Is(err, ErrGrantExpired):
+		return nil, &DeriveError{Type: "invalid_grant", Description: err.Error()}
+	case err != nil:
+		return nil, err
+	}
+	sub, toolName, err := subset(g.Plan.Details, details)
+	if err != nil {
+		return nil, &DeriveError{Type: "invalid_authorization_details", Description: err.Error()}
+	}
+	if want := g.Plan.Audiences[toolName]; audience == "" || audience != want {
+		return nil, &DeriveError{Type: "invalid_target", Description: fmt.Sprintf("audience is not the grant's %s audience", toolName)}
+	}
+	exp := now.Add(p.tokenTTL)
+	if g.ExpiresAt.Before(exp) {
+		exp = g.ExpiresAt
+	}
+	claims := struct {
+		Issuer      string          `json:"iss"`
+		Subject     string          `json:"sub"`
+		Audience    string          `json:"aud"`
+		AZP         string          `json:"azp"`
+		IssuedAt    int64           `json:"iat"`
+		Expiry      int64           `json:"exp"`
+		ID          string          `json:"jti"`
+		Details     json.RawMessage `json:"authorization_details"`
+		Grant       string          `json:"pathops_grant"`
+		Operation   string          `json:"pathops_operation"`
+		Application string          `json:"pathops_application"`
+		Run         string          `json:"pathops_run"`
+	}{issuer, g.Plan.Subject, audience, delegateID, now.Unix(), exp.Unix(), storage.NewID(), sub,
+		g.Plan.ID, g.Plan.Operation, g.Plan.Application.ID, g.Plan.Run.ID}
+	payload, err := json.Marshal(claims)
+	if err != nil {
+		return nil, err
+	}
+	tok, err := sig.Sign(ctx, payload)
+	if err != nil {
+		return nil, fmt.Errorf("signing a delegated token: %w", err)
+	}
+	return &Derived{Token: tok, Expiry: exp, Audience: audience, Details: sub}, nil
+}
diff --git a/server/delegation/flow.go b/server/delegation/flow.go
new file mode 100644
index 0000000..d7ba6e0
--- /dev/null
+++ b/server/delegation/flow.go
@@ -0,0 +1,40 @@
+package delegation
+
+import (
+	"errors"
+	"time"
+
+	"github.com/dexidp/dex/server/internal"
+	"github.com/dexidp/dex/storage"
+)
+
+// Errors of an authorization request carrying a plan. Their text is shown to
+// the user.
+var (
+	ErrNotAFlow    = errors.New("this authorization request cannot be used directly; start the operation again")
+	ErrWrongUser   = errors.New("this authorization was prepared for another user; sign in as the user who started the operation")
+	ErrPlanExpired = errors.New("this authorization plan expired; start the operation again")
+)
+
+// CheckAuthRequest returns the delegation state of a logged-in authorization
+// request after checking it may continue: it is a flow (not the stored pushed
+// request, and its request_uri was consumed), the authenticated user is the
+// plan's subject, and the plan has not expired. It returns nil, nil for a
+// request without delegation.
+func CheckAuthRequest(authReq storage.AuthRequest, now time.Time) (*Request, error) {
+	d, err := DecodeRequest(authReq.Delegation)
+	if err != nil || d == nil {
+		return nil, err
+	}
+	if d.Pushed || d.PushedID != "" {
+		return nil, ErrNotAFlow
+	}
+	sub, err := internal.Marshal(&internal.IDTokenSubject{UserId: authReq.Claims.UserID, ConnId: authReq.ConnectorID})
+	if err != nil || !authReq.LoggedIn || sub != d.Plan.Subject {
+		return nil, ErrWrongUser
+	}
+	if !now.Before(d.Plan.Expiry) {
+		return nil, ErrPlanExpired
+	}
+	return d, nil
+}
diff --git a/server/delegation/grant.go b/server/delegation/grant.go
new file mode 100644
index 0000000..850437b
--- /dev/null
+++ b/server/delegation/grant.go
@@ -0,0 +1,223 @@
+package delegation
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/dexidp/dex/storage"
+)
+
+// Request is the delegation state of an AuthRequest and of the AuthCode
+// issued from it (their Delegation field).
+type Request struct {
+	// Pushed marks the stored pushed request: it is only a template for the
+	// authorization request its request_uri starts, never a flow of its own.
+	Pushed bool `json:"pushed,omitempty"`
+	// PushedID is the pushed request an authorization request was started
+	// from; it is consumed (deleted) when that request is created.
+	PushedID string `json:"pushedId,omitempty"`
+	Plan     Plan   `json:"plan"`
+}
+
+// Encode is r as stored.
+func (r *Request) Encode() []byte {
+	b, err := json.Marshal(r)
+	if err != nil {
+		panic(err) // a Request always marshals
+	}
+	return b
+}
+
+// DecodeRequest reads a stored Delegation field (nil, nil when empty).
+func DecodeRequest(b []byte) (*Request, error) {
+	if len(b) == 0 {
+		return nil, nil
+	}
+	var r Request
+	if err := json.Unmarshal(b, &r); err != nil {
+		return nil, fmt.Errorf("delegation state: %v", err)
+	}
+	return &r, nil
+}
+
+// Grant status.
+const (
+	// GrantApproved: the user approved the plan; not usable until the
+	// authorization code is redeemed with the plan's PKCE verifier.
+	GrantApproved = "approved"
+	// GrantActive: approved and completed by the plan's client.
+	GrantActive = "active"
+)
+
+// Grant is an operation grant: one approved plan of one user.
+type Grant struct {
+	Version     int       `json:"v"`
+	Status      string    `json:"status"`
+	Plan        Plan      `json:"plan"`
+	ApprovedAt  time.Time `json:"approvedAt"`
+	ActivatedAt time.Time `json:"activatedAt,omitzero"`
+	ExpiresAt   time.Time `json:"expiresAt"`
+}
+
+// grantKeyPrefix marks grants in UserIdentity.Consents (whose other keys are
+// client ids).
+const grantKeyPrefix = "pathops.io/operation-grant/"
+
+// Errors of loading a grant for a derivation. Their text is returned to the
+// delegate.
+var (
+	ErrGrantNotFound = errors.New("operation grant not found")
+	ErrGrantInactive = errors.New("operation grant not completed (authorization code not redeemed)")
+	ErrGrantExpired  = errors.New("operation grant expired")
+)
+
+// Handle is the operation grant handle a delegate presents: it identifies
+// the grant (plan id) and its user (subject). It is not a credential: only the
+// plan's delegate, authenticated, can use it.
+func Handle(planID, subject string) string { return "pog1:" + planID + ":" + subject }
+
+func parseHandle(h string) (planID, subject string, ok bool) {
+	parts := strings.Split(h, ":")
+	if len(parts) != 3 || parts[0] != "pog1" || parts[1] == "" || parts[2] == "" {
+		return "", "", false
+	}
+	return parts[1], parts[2], true
+}
+
+func decodeGrant(values []string) (*Grant, error) {
+	if len(values) != 1 {
+		return nil, errors.New("malformed operation grant")
+	}
+	var g Grant
+	if err := json.Unmarshal([]byte(values[0]), &g); err != nil || g.Version != 1 {
+		return nil, errors.New("malformed operation grant")
+	}
+	return &g, nil
+}
+
+func encodeGrant(g *Grant) []string {
+	b, err := json.Marshal(g)
+	if err != nil {
+		panic(err) // a Grant always marshals
+	}
+	return []string{string(b)}
+}
+
+// updateIdentity applies fn to the user's identity, creating it when absent.
+func updateIdentity(ctx context.Context, s storage.Storage, userID, connID string, claims storage.Claims, now time.Time,
+	fn func(map[string][]string) error) error {
+	update := func() error {
+		return s.UpdateUserIdentity(ctx, userID, connID, func(old storage.UserIdentity) (storage.UserIdentity, error) {
+			if old.Consents == nil {
+				old.Consents = map[string][]string{}
+			}
+			if err := fn(old.Consents); err != nil {
+				return old, err
+			}
+			return old, nil
+		})
+	}
+	err := update()
+	if !errors.Is(err, storage.ErrNotFound) {
+		return err
+	}
+	consents := map[string][]string{}
+	if err := fn(consents); err != nil {
+		return err
+	}
+	err = s.CreateUserIdentity(ctx, storage.UserIdentity{UserID: userID, ConnectorID: connID, Claims: claims,
+		Consents: consents, CreatedAt: now, LastLogin: now})
+	if errors.Is(err, storage.ErrAlreadyExists) {
+		return update()
+	}
+	return err
+}
+
+// pruneAfter: expired grants are kept this long (for inspection), then
+// dropped on the next write of the user's identity.
+const pruneAfter = 24 * time.Hour
+
+func prune(consents map[string][]string, now time.Time) {
+	for k, v := range consents {
+		if !strings.HasPrefix(k, grantKeyPrefix) {
+			continue
+		}
+		if g, err := decodeGrant(v); err != nil || now.After(g.ExpiresAt.Add(pruneAfter)) {
+			delete(consents, k)
+		}
+	}
+}
+
+// Approve records the user's approval of plan (status approved). Approving
+// the same plan again replaces the grant.
+func (p *Policy) Approve(ctx context.Context, s storage.Storage, plan *Plan, claims storage.Claims, now time.Time) (*Grant, error) {
+	userID, connID := plan.UserID()
+	if userID == "" {
+		return nil, errors.New("plan subject cannot be decoded")
+	}
+	g := &Grant{Version: 1, Status: GrantApproved, Plan: *plan, ApprovedAt: now, ExpiresAt: now.Add(p.grantTTL)}
+	err := updateIdentity(ctx, s, userID, connID, claims, now, func(c map[string][]string) error {
+		prune(c, now)
+		c[grantKeyPrefix+plan.ID] = encodeGrant(g)
+		return nil
+	})
+	return g, err
+}
+
+// Activate completes the approved grant of plan: its authorization code was
+// redeemed with the plan's PKCE verifier.
+func (p *Policy) Activate(ctx context.Context, s storage.Storage, plan *Plan, now time.Time) (*Grant, error) {
+	userID, connID := plan.UserID()
+	var out *Grant
+	err := s.UpdateUserIdentity(ctx, userID, connID, func(old storage.UserIdentity) (storage.UserIdentity, error) {
+		g, err := decodeGrant(old.Consents[grantKeyPrefix+plan.ID])
+		if err != nil {
+			return old, ErrGrantNotFound
+		}
+		if g.Plan.DetailsSHA256 != plan.DetailsSHA256 || g.Plan.Subject != plan.Subject {
+			return old, errors.New("the operation grant changed since this authorization code was issued")
+		}
+		if !now.Before(g.ExpiresAt) {
+			return old, ErrGrantExpired
+		}
+		g.Status, g.ActivatedAt = GrantActive, now
+		old.Consents[grantKeyPrefix+plan.ID] = encodeGrant(g)
+		out = g
+		return old, nil
+	})
+	return out, err
+}
+
+// load returns the usable grant of a handle for delegate at now.
+func (p *Policy) load(ctx context.Context, s storage.Storage, handle, delegateID string, now time.Time) (*Grant, error) {
+	planID, subject, ok := parseHandle(handle)
+	if !ok {
+		return nil, ErrGrantNotFound
+	}
+	pl := Plan{Subject: subject}
+	userID, connID := pl.UserID()
+	if userID == "" {
+		return nil, ErrGrantNotFound
+	}
+	ui, err := s.GetUserIdentity(ctx, userID, connID)
+	if errors.Is(err, storage.ErrNotFound) {
+		return nil, ErrGrantNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	g, err := decodeGrant(ui.Consents[grantKeyPrefix+planID])
+	switch {
+	case err != nil, g.Plan.ID != planID, g.Plan.Subject != subject, g.Plan.Delegate != delegateID:
+		return nil, ErrGrantNotFound
+	case !now.Before(g.ExpiresAt):
+		return nil, ErrGrantExpired
+	case g.Status != GrantActive:
+		return nil, ErrGrantInactive
+	}
+	return g, nil
+}
diff --git a/server/delegation/plan.go b/server/delegation/plan.go
new file mode 100644
index 0000000..b545267
--- /dev/null
+++ b/server/delegation/plan.go
@@ -0,0 +1,398 @@
+package delegation
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+
+	"github.com/dexidp/dex/server/internal"
+)
+
+// Plan is a verified Authorization Plan.
+type Plan struct {
+	ID       string    `json:"id"`
+	Issuer   string    `json:"iss"`
+	Delegate string    `json:"delegate"`
+	Subject  string    `json:"sub"`
+	IssuedAt time.Time `json:"iat"`
+	Expiry   time.Time `json:"exp"`
+
+	Installation string      `json:"installation"`
+	Operation    string      `json:"operation"`
+	Application  Application `json:"application"`
+	Run          Run         `json:"run"`
+	Template     Template    `json:"template"`
+
+	ClientID            string `json:"client_id"`
+	RedirectURI         string `json:"redirect_uri"`
+	CodeChallenge       string `json:"code_challenge"`
+	CodeChallengeMethod string `json:"code_challenge_method"`
+
+	// Audiences maps each tool of the details to its token audience.
+	Audiences map[string]string `json:"audiences"`
+	// Details is the canonical JSON array of authorization_details.
+	Details       json.RawMessage `json:"authorization_details"`
+	DetailsSHA256 string          `json:"authorization_details_sha256"`
+}
+
+// Application names the plan's Application.
+type Application struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+}
+
+// Run names the plan's durable Run.
+type Run struct {
+	ID string `json:"id"`
+}
+
+// Template is the template provenance of the operation.
+type Template struct {
+	ID       string `json:"id"`
+	Source   string `json:"source"`
+	Ref      string `json:"ref"`
+	Revision string `json:"revision,omitempty"`
+}
+
+// planClaims is the plan's JWS payload, decoded strictly.
+type planClaims struct {
+	Issuer   string          `json:"iss"`
+	Audience string          `json:"aud"`
+	Subject  string          `json:"sub"`
+	ID       string          `json:"jti"`
+	IssuedAt int64           `json:"iat"`
+	Expiry   int64           `json:"exp"`
+	Plan     planBody        `json:"pathops_plan"`
+	Details  json.RawMessage `json:"authorization_details"`
+}
+
+type planBody struct {
+	Version             int               `json:"version"`
+	Installation        string            `json:"installation"`
+	Operation           string            `json:"operation"`
+	Application         Application       `json:"application"`
+	Run                 Run               `json:"run"`
+	Template            Template          `json:"template"`
+	ClientID            string            `json:"client_id"`
+	RedirectURI         string            `json:"redirect_uri"`
+	CodeChallenge       string            `json:"code_challenge"`
+	CodeChallengeMethod string            `json:"code_challenge_method"`
+	Audiences           map[string]string `json:"audiences"`
+	DetailsSHA256       string            `json:"authorization_details_sha256"`
+}
+
+// ErrInvalidPlan: the plan is not acceptable. Its message is safe to return
+// to the client.
+var ErrInvalidPlan = errors.New("invalid authorization plan")
+
+func invalid(format string, a ...any) error {
+	return fmt.Errorf("%w: %s", ErrInvalidPlan, fmt.Sprintf(format, a...))
+}
+
+var (
+	planID      = regexp.MustCompile(`^[A-Za-z0-9-]{8,64}$`)
+	operation   = regexp.MustCompile(`^[A-Z][A-Z0-9_]{0,63}$`)
+	challenge   = regexp.MustCompile(`^[A-Za-z0-9_-]{43}$`)
+	maxPlanSize = 96 << 10
+	clockSkew   = time.Minute
+)
+
+// VerifyPlan verifies a signed plan for this Dex (issuer) at now.
+func (p *Policy) VerifyPlan(raw, issuer string, now time.Time) (*Plan, error) {
+	if raw == "" || len(raw) > maxPlanSize {
+		return nil, invalid("missing or too large")
+	}
+	jws, err := jose.ParseSigned(raw, []jose.SignatureAlgorithm{jose.EdDSA})
+	if err != nil {
+		return nil, invalid("not an EdDSA JWS")
+	}
+	if len(jws.Signatures) != 1 {
+		return nil, invalid("exactly one signature is required")
+	}
+	h := jws.Signatures[0].Protected
+	if typ, _ := h.ExtraHeaders[jose.HeaderType].(string); typ != PlanTokenType {
+		return nil, invalid("typ must be %s", PlanTokenType)
+	}
+	var unverified struct {
+		Issuer string `json:"iss"`
+	}
+	if err := json.Unmarshal(jws.UnsafePayloadWithoutVerification(), &unverified); err != nil {
+		return nil, invalid("payload is not JSON")
+	}
+	d := p.byIssuer[unverified.Issuer]
+	if d == nil {
+		return nil, invalid("untrusted plan issuer")
+	}
+	key, ok := d.keys[h.KeyID]
+	if !ok {
+		return nil, invalid("unknown plan key")
+	}
+	payload, err := jws.Verify(key)
+	if err != nil {
+		return nil, invalid("bad signature")
+	}
+	var c planClaims
+	dec := json.NewDecoder(bytes.NewReader(payload))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&c); err != nil || dec.More() {
+		return nil, invalid("unexpected claims")
+	}
+	iat, exp := time.Unix(c.IssuedAt, 0), time.Unix(c.Expiry, 0)
+	switch {
+	case c.Issuer != d.issuer:
+		return nil, invalid("issuer changed")
+	case c.Audience != issuer:
+		return nil, invalid("audience is not this issuer")
+	case c.IssuedAt == 0 || c.Expiry == 0 || !exp.After(iat) || exp.Sub(iat) > p.maxPlanLifetime:
+		return nil, invalid("iat/exp missing or lifetime above %s", p.maxPlanLifetime)
+	case iat.After(now.Add(clockSkew)):
+		return nil, invalid("issued in the future")
+	case !now.Before(exp):
+		return nil, invalid("expired")
+	case !planID.MatchString(c.ID):
+		return nil, invalid("jti")
+	case c.Plan.Version != PlanVersion:
+		return nil, invalid("unsupported version %d", c.Plan.Version)
+	case !identifier.MatchString(c.Plan.Installation) || !operation.MatchString(c.Plan.Operation):
+		return nil, invalid("installation or operation")
+	case !planID.MatchString(c.Plan.Application.ID) || !identifier.MatchString(c.Plan.Application.Name) || !planID.MatchString(c.Plan.Run.ID):
+		return nil, invalid("application or run")
+	case c.Plan.Template.ID == "" || c.Plan.Template.Source == "" || c.Plan.Template.Ref == "":
+		return nil, invalid("template provenance")
+	case !p.planClients[c.Plan.ClientID]:
+		return nil, invalid("client_id may not carry plans")
+	case c.Plan.RedirectURI == "":
+		return nil, invalid("redirect_uri")
+	case c.Plan.CodeChallengeMethod != "S256" || !challenge.MatchString(c.Plan.CodeChallenge):
+		return nil, invalid("an S256 code_challenge is required")
+	}
+	var sub internal.IDTokenSubject
+	if err := internal.Unmarshal(c.Subject, &sub); err != nil || sub.UserId == "" || sub.ConnId == "" {
+		return nil, invalid("sub is not a subject of this issuer")
+	}
+	details, err := Canonical(c.Details)
+	if err != nil {
+		return nil, invalid("authorization_details: %v", err)
+	}
+	if DigestOf(details) != c.Plan.DetailsSHA256 {
+		return nil, invalid("authorization_details_sha256 does not match")
+	}
+	if err := d.checkDetails(details, c.Plan.Audiences); err != nil {
+		return nil, err
+	}
+	return &Plan{
+		ID: c.ID, Issuer: c.Issuer, Delegate: d.client, Subject: c.Subject, IssuedAt: iat, Expiry: exp,
+		Installation: c.Plan.Installation, Operation: c.Plan.Operation, Application: c.Plan.Application,
+		Run: c.Plan.Run, Template: c.Plan.Template, ClientID: c.Plan.ClientID, RedirectURI: c.Plan.RedirectURI,
+		CodeChallenge: c.Plan.CodeChallenge, CodeChallengeMethod: c.Plan.CodeChallengeMethod,
+		Audiences: c.Plan.Audiences, Details: details, DetailsSHA256: c.Plan.DetailsSHA256,
+	}, nil
+}
+
+// MatchPushed checks that a pushed authorization request carries exactly the
+// plan: the same client, redirect URI, PKCE challenge and (canonically) the
+// same authorization_details. The client cannot add, drop, reorder or change a
+// detail.
+func (pl *Plan) MatchPushed(clientID, redirectURI, codeChallenge, method, details string) error {
+	switch {
+	case clientID != pl.ClientID:
+		return invalid("client_id differs from the plan")
+	case redirectURI != pl.RedirectURI:
+		return invalid("redirect_uri differs from the plan")
+	case codeChallenge != pl.CodeChallenge || method != pl.CodeChallengeMethod:
+		return invalid("PKCE code_challenge differs from the plan")
+	}
+	c, err := Canonical([]byte(details))
+	if err != nil {
+		return invalid("authorization_details: %v", err)
+	}
+	if !bytes.Equal(c, pl.Details) {
+		return invalid("authorization_details differ from the plan")
+	}
+	return nil
+}
+
+// UserID and ConnectorID of the plan's subject.
+func (pl *Plan) UserID() (userID, connectorID string) {
+	var sub internal.IDTokenSubject
+	if internal.Unmarshal(pl.Subject, &sub) != nil {
+		return "", ""
+	}
+	return sub.UserId, sub.ConnId
+}
+
+// detail is the part of an authorization detail Dex interprets.
+type detail struct {
+	Type    string   `json:"type"`
+	Tool    string   `json:"tool"`
+	Actions []string `json:"actions"`
+}
+
+const maxDetails = 32
+
+// elements splits a canonical JSON array into its canonical elements.
+func elements(canonical []byte) ([]json.RawMessage, error) {
+	var out []json.RawMessage
+	if err := json.Unmarshal(canonical, &out); err != nil {
+		return nil, invalid("authorization_details must be an array")
+	}
+	return out, nil
+}
+
+// checkDetails validates canonical details for d: 1 to maxDetails distinct
+// objects, each with a type of a configured tool, that tool, and a sorted,
+// distinct, non-empty actions list; audiences name exactly the tools used,
+// each matching its tool's pattern.
+func (d *delegate) checkDetails(canonical []byte, audiences map[string]string) error {
+	els, err := elements(canonical)
+	if err != nil {
+		return err
+	}
+	if len(els) == 0 || len(els) > maxDetails {
+		return invalid("1 to %d authorization_details are required", maxDetails)
+	}
+	used := map[string]bool{}
+	seen := map[string]bool{}
+	for _, el := range els {
+		if seen[string(el)] {
+			return invalid("a detail is repeated")
+		}
+		seen[string(el)] = true
+		var dt detail
+		if err := json.Unmarshal(el, &dt); err != nil {
+			return invalid("a detail is not an object with type, tool and actions")
+		}
+		t := d.tools[dt.Tool]
+		switch {
+		case t == nil:
+			return invalid("tool %q is not configured for %s", dt.Tool, d.client)
+		case !t.types[dt.Type]:
+			return invalid("type %q is not a %s detail type", dt.Type, dt.Tool)
+		case len(dt.Actions) == 0 || !slices.IsSorted(dt.Actions) || len(slices.Compact(slices.Clone(dt.Actions))) != len(dt.Actions):
+			return invalid("actions of a %s detail must be sorted, distinct and non-empty", dt.Type)
+		}
+		for _, a := range dt.Actions {
+			if !identifier.MatchString(a) {
+				return invalid("action %q", a)
+			}
+		}
+		used[dt.Tool] = true
+	}
+	if len(audiences) != len(used) {
+		return invalid("audiences must name exactly the tools of the details")
+	}
+	for name, aud := range audiences {
+		if !used[name] || !d.tools[name].audience.MatchString(aud) {
+			return invalid("audience of %q is missing or does not match its pattern", name)
+		}
+	}
+	return nil
+}
+
+// subset returns the requested details (canonical) and their tool when they
+// are a non-empty set of distinct details of the grant, all of one tool.
+func subset(granted json.RawMessage, requested string) (json.RawMessage, string, error) {
+	c, err := Canonical([]byte(requested))
+	if err != nil {
+		return nil, "", fmt.Errorf("authorization_details: %v", err)
+	}
+	req, err := elements(c)
+	if err != nil {
+		return nil, "", err
+	}
+	have, err := elements(granted)
+	if err != nil {
+		return nil, "", err
+	}
+	if len(req) == 0 {
+		return nil, "", errors.New("authorization_details is empty")
+	}
+	toolName := ""
+	seen := map[string]bool{}
+	for _, el := range req {
+		if seen[string(el)] {
+			return nil, "", errors.New("a requested detail is repeated")
+		}
+		seen[string(el)] = true
+		if !slices.ContainsFunc(have, func(g json.RawMessage) bool { return bytes.Equal(g, el) }) {
+			return nil, "", errors.New("a requested detail is not in the operation grant")
+		}
+		var dt detail
+		_ = json.Unmarshal(el, &dt) // granted details were validated
+		if toolName != "" && dt.Tool != toolName {
+			return nil, "", errors.New("requested details name more than one tool")
+		}
+		toolName = dt.Tool
+	}
+	return c, toolName, nil
+}
+
+// Describe renders the plan's details as consent lines.
+func (p *Policy) Describe(pl *Plan) []string {
+	d := p.delegates[pl.Delegate]
+	els, _ := elements(pl.Details)
+	out := make([]string, 0, len(els))
+	for _, el := range els {
+		var m map[string]any
+		_ = json.Unmarshal(el, &m)
+		var dt detail
+		_ = json.Unmarshal(el, &dt)
+		display := dt.Tool
+		if d != nil && d.tools[dt.Tool] != nil {
+			display = d.tools[dt.Tool].display
+		}
+		out = append(out, display+": "+describe(dt, m))
+	}
+	return out
+}
+
+func describe(dt detail, m map[string]any) string {
+	str := func(k string) string { s, _ := m[k].(string); return s }
+	repo := str("owner") + "/" + str("repository")
+	switch dt.Type {
+	case "pathops_repository":
+		var verbs []string
+		for _, a := range dt.Actions {
+			switch a {
+			case "create":
+				verbs = append(verbs, "create")
+			case "seed":
+				verbs = append(verbs, "write the template's initial content to")
+			default:
+				verbs = append(verbs, a)
+			}
+		}
+		return fmt.Sprintf("%s the private repository %s", strings.Join(verbs, " and "), repo)
+	case "pathops_webhook":
+		return fmt.Sprintf("%s the webhook of %s that sends %s events to %s",
+			strings.Join(dt.Actions, " and "), repo, eventList(m["events"]), str("url"))
+	}
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		if k != "type" && k != "tool" && k != "actions" {
+			keys = append(keys, k)
+		}
+	}
+	slices.Sort(keys)
+	parts := []string{dt.Type, strings.Join(dt.Actions, ",")}
+	for _, k := range keys {
+		parts = append(parts, fmt.Sprintf("%s=%v", k, m[k]))
+	}
+	return strings.Join(parts, " ")
+}
+
+func eventList(v any) string {
+	list, _ := v.([]any)
+	s := make([]string, 0, len(list))
+	for _, e := range list {
+		s = append(s, fmt.Sprint(e))
+	}
+	return strings.Join(s, ", ")
+}
