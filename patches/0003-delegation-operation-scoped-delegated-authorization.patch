+	t       *testing.T
+	s       *Server
+	issuer  string
+	clock   *time.Time
+	key     ed25519.PrivateKey
+	kid     string
+	subject string
+}
+
+func newDelegationEnv(t *testing.T) *dlgEnv {
+	t.Helper()
+	pub, priv, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	clock := time.Now()
+	e := &dlgEnv{t: t, clock: &clock, key: priv, kid: "plan-1"}
+	_, s := newTestServer(t, func(c *Config) {
+		c.Now = func() time.Time { return *e.clock }
+		policy, err := delegation.NewPolicy(delegation.Config{
+			PlanClients: []string{dlgCLI},
+			Delegates: []delegation.DelegateConfig{{
+				Client: dlgTCP, Name: "PathOps Tenant Control Plane (test)", PlanIssuer: dlgPlanIssuer,
+				PlanKeys: []delegation.KeyConfig{{KeyID: "plan-1", Ed25519: base64.RawURLEncoding.EncodeToString(pub)}},
+				Tools: []delegation.ToolConfig{{Name: "forgejo", DisplayName: "Forgejo",
+					AudiencePattern: `u:[0-9]+:[0-9a-f-]{36}`, DetailTypes: []string{"pathops_repository", "pathops_webhook"}}},
+			}},
+		})
+		require.NoError(t, err)
+		c.Delegation = policy
+		for _, cl := range []storage.Client{
+			{ID: dlgCLI, Public: true, RedirectURIs: []string{dlgRedirect}, Name: "PathOps CLI"},
+			{ID: dlgTCP, Secret: dlgTCPSecret, Name: "PathOps Tenant Control Plane"},
+			{ID: dlgOther, Secret: "other-secret", Name: "Other"},
+		} {
+			require.NoError(t, c.Storage.CreateClient(t.Context(), cl))
+		}
+		e.issuer = c.Issuer
+	})
+	e.s = s
+	e.subject, err = tokens.GenSubject(dlgMockUserID, "mock")
+	require.NoError(t, err)
+	return e
+}
+
+func dlgDetails(owner, app, appID string) []map[string]any {
+	repo := func(name string) map[string]any {
+		return map[string]any{"type": "pathops_repository", "version": 1, "tool": "forgejo", "owner": owner,
+			"repository": name, "actions": []string{"create", "seed"}}
+	}
+	return []map[string]any{
+		repo(app), repo(app + "-gitops-preflight"), repo(app + "-gitops-production"),
+		{"type": "pathops_webhook", "version": 1, "tool": "forgejo", "owner": owner, "repository": app,
+			"url": dlgWebhookBase + appID, "events": []string{"push"}, "actions": []string{"configure"}},
+	}
+}
+
+func randomHex(n int) string {
+	b := make([]byte, n)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+func mustJSON(t *testing.T, v any) string {
+	t.Helper()
+	b, err := json.Marshal(v)
+	require.NoError(t, err)
+	return string(b)
+}
+
+type dlgPKCE struct{ verifier, challenge string }
+
+func newPKCE() dlgPKCE {
+	b := make([]byte, 32)
+	_, _ = rand.Read(b)
+	v := base64.RawURLEncoding.EncodeToString(b)
+	sum := sha256.Sum256([]byte(v))
+	return dlgPKCE{v, base64.RawURLEncoding.EncodeToString(sum[:])}
+}
+
+// plan builds and signs a plan for app; mod may change the claims first.
+func (e *dlgEnv) plan(app string, pk dlgPKCE, details []map[string]any, mod func(map[string]any)) (string, string) {
+	t := e.t
+	raw := mustJSON(t, details)
+	canonical, err := delegation.Canonical([]byte(raw))
+	require.NoError(t, err)
+	now := *e.clock
+	appID := "11111111-2222-4333-8444-" + strings.Repeat("a", 12)
+	if app == "app-b" {
+		appID = "11111111-2222-4333-8444-" + strings.Repeat("b", 12)
+	}
+	claims := map[string]any{
+		"iss": dlgPlanIssuer, "aud": e.issuer, "sub": e.subject, "jti": "plan-" + app + "-" + randomHex(8),
+		"iat": now.Unix(), "exp": now.Add(10 * time.Minute).Unix(),
+		"pathops_plan": map[string]any{
+			"version": 1, "installation": "dev", "operation": "CREATE_APPLICATION",
+			"application": map[string]any{"id": appID, "name": app},
+			"run":         map[string]any{"id": "33333333-2222-4333-8444-" + strings.Repeat("c", 12)},
+			"template":    map[string]any{"id": "generic-container", "source": "https://github.com/PathOps/pathops-templates", "ref": "main"},
+			"client_id":   dlgCLI, "redirect_uri": dlgRedirect, "code_challenge": pk.challenge, "code_challenge_method": "S256",
+			"audiences":                    map[string]any{"forgejo": dlgAudience},
+			"authorization_details_sha256": delegation.DigestOf(canonical),
+		},
+		"authorization_details": json.RawMessage(canonical),
+	}
+	if mod != nil {
+		mod(claims)
+	}
+	return e.sign(e.key, e.kid, claims), raw
+}
+
+func (e *dlgEnv) sign(key ed25519.PrivateKey, kid string, claims map[string]any) string {
+	opts := (&jose.SignerOptions{}).WithType(delegation.PlanTokenType).WithHeader(jose.HeaderKey("kid"), kid)
+	sig, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: key}, opts)
+	require.NoError(e.t, err)
+	jws, err := sig.Sign([]byte(mustJSON(e.t, claims)))
+	require.NoError(e.t, err)
+	out, err := jws.CompactSerialize()
+	require.NoError(e.t, err)
+	return out
+}
+
+func (e *dlgEnv) do(method, target string, form url.Values, basic ...string) *httptest.ResponseRecorder {
+	var req *http.Request
+	if form != nil {
+		req = httptest.NewRequest(method, target, strings.NewReader(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	} else {
+		req = httptest.NewRequest(method, target, nil)
+	}
+	if len(basic) == 2 {
+		req.SetBasicAuth(basic[0], basic[1])
+	}
+	rr := httptest.NewRecorder()
+	e.s.ServeHTTP(rr, req)
+	return rr
+}
+
+func (e *dlgEnv) par(plan, details string, pk dlgPKCE) *httptest.ResponseRecorder {
+	return e.do(http.MethodPost, "/par", url.Values{
+		"client_id": {dlgCLI}, "response_type": {"code"}, "scope": {"openid email profile"},
+		"redirect_uri": {dlgRedirect}, "state": {"st"}, "code_challenge": {pk.challenge},
+		"code_challenge_method": {"S256"}, "authorization_details": {details}, "pathops_authorization_plan": {plan},
+	})
+}
+
+func (e *dlgEnv) requestURI(plan, details string, pk dlgPKCE) string {
+	rr := e.par(plan, details, pk)
+	require.Equal(e.t, http.StatusCreated, rr.Code, rr.Body.String())
+	var out struct {
+		RequestURI string `json:"request_uri"`
+		ExpiresIn  int    `json:"expires_in"`
+	}
+	require.NoError(e.t, json.Unmarshal(rr.Body.Bytes(), &out))
+	require.True(e.t, strings.HasPrefix(out.RequestURI, delegation.RequestURIPrefix))
+	require.Equal(e.t, 90, out.ExpiresIn)
+	return out.RequestURI
+}
+
+// browse follows redirects from target until a page renders or the client's
+// redirect URI is reached.
+func (e *dlgEnv) browse(target string) (*httptest.ResponseRecorder, *url.URL) {
+	rr := e.do(http.MethodGet, target, nil)
+	for range 12 {
+		if rr.Code != http.StatusFound && rr.Code != http.StatusSeeOther {
+			return rr, nil
+		}
+		u, err := url.Parse(rr.Header().Get("Location"))
+		require.NoError(e.t, err)
+		if u.Host == "127.0.0.1:5555" {
+			return rr, u
+		}
+		rr = e.do(http.MethodGet, u.RequestURI(), nil)
+	}
+	e.t.Fatal("redirect loop")
+	return nil, nil
+}
+
+// consent starts the browser at request_uri and returns the consent page and
+// its URL (with req and hmac).
+func (e *dlgEnv) consent(requestURI string) (string, string) {
+	q := url.Values{"client_id": {dlgCLI}, "request_uri": {requestURI}}
+	rr := e.do(http.MethodGet, "/auth?"+q.Encode(), nil)
+	var page string
+	for range 12 {
+		require.Contains(e.t, []int{http.StatusFound, http.StatusSeeOther}, rr.Code, rr.Body.String())
+		loc := rr.Header().Get("Location")
+		u, err := url.Parse(loc)
+		require.NoError(e.t, err)
+		next := e.do(http.MethodGet, u.RequestURI(), nil)
+		if strings.HasSuffix(u.Path, "/approval") && next.Code == http.StatusOK {
+			page = next.Body.String()
+			return page, u.RequestURI()
+		}
+		rr = next
+	}
+	e.t.Fatal("no consent page")
+	return "", ""
+}
+
+func (e *dlgEnv) approve(approvalURL, decision string) *url.URL {
+	rr := e.do(http.MethodPost, approvalURL, url.Values{"approval": {decision}})
+	require.Equal(e.t, http.StatusSeeOther, rr.Code, rr.Body.String())
+	u, err := url.Parse(rr.Header().Get("Location"))
+	require.NoError(e.t, err)
+	if u.Host == "127.0.0.1:5555" {
+		return u
+	}
+	_, cb := e.browse(u.RequestURI())
+	require.NotNil(e.t, cb)
+	return cb
+}
+
+func (e *dlgEnv) redeem(code string, pk dlgPKCE) *httptest.ResponseRecorder {
+	return e.do(http.MethodPost, "/token", url.Values{"grant_type": {"authorization_code"}, "code": {code},
+		"redirect_uri": {dlgRedirect}, "code_verifier": {pk.verifier}, "client_id": {dlgCLI}})
+}
+
+func (e *dlgEnv) derive(handle, audience string, details []map[string]any, basic ...string) *httptest.ResponseRecorder {
+	if basic == nil {
+		basic = []string{dlgTCP, dlgTCPSecret}
+	}
+	return e.do(http.MethodPost, "/token", url.Values{
+		"grant_type":            {"urn:ietf:params:oauth:grant-type:token-exchange"},
+		"subject_token":         {handle},
+		"subject_token_type":    {delegation.OperationGrantTokenType},
+		"requested_token_type":  {"urn:ietf:params:oauth:token-type:access_token"},
+		"audience":              {audience},
+		"authorization_details": {mustJSON(e.t, details)},
+	}, basic...)
+}
+
+// granted runs the whole flow for app and returns the plan id.
+func (e *dlgEnv) granted(app string) (string, []map[string]any) {
+	pk := newPKCE()
+	details := dlgDetails("kilgore", app, "app-id-"+app)
+	plan, raw := e.plan(app, pk, details, nil)
+	page, approval := e.consent(e.requestURI(plan, raw, pk))
+	require.Contains(e.t, page, "kilgore/"+app)
+	cb := e.approve(approval, "approve")
+	code := cb.Query().Get("code")
+	require.NotEmpty(e.t, code)
+	rr := e.redeem(code, pk)
+	require.Equal(e.t, http.StatusOK, rr.Code, rr.Body.String())
+	return planID(e.t, plan), details
+}
+
+func planID(t *testing.T, plan string) string {
+	jws, err := jose.ParseSigned(plan, []jose.SignatureAlgorithm{jose.EdDSA})
+	require.NoError(t, err)
+	var c struct {
+		ID string `json:"jti"`
+	}
+	require.NoError(t, json.Unmarshal(jws.UnsafePayloadWithoutVerification(), &c))
+	return c.ID
+}
+
+func jwtClaims(t *testing.T, tok string) map[string]any {
+	parts := strings.Split(tok, ".")
+	require.Len(t, parts, 3)
+	b, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	var m map[string]any
+	require.NoError(t, json.Unmarshal(b, &m))
+	return m
+}
+
+func errorOf(t *testing.T, rr *httptest.ResponseRecorder) string {
+	var e struct {
+		Error string `json:"error"`
+	}
+	_ = json.Unmarshal(rr.Body.Bytes(), &e)
+	return e.Error
+}
+
+func TestDelegationFlow(t *testing.T) {
+	e := newDelegationEnv(t)
+
+	pk := newPKCE()
+	details := dlgDetails("kilgore", "app-a", "app-id-app-a")
+	plan, raw := e.plan("app-a", pk, details, nil)
+	id := planID(t, plan)
+	handle := delegation.Handle(id, e.subject)
+
+	page, approval := e.consent(e.requestURI(plan, raw, pk))
+	for _, want := range []string{"PathOps Tenant Control Plane (test)", "CREATE_APPLICATION", "app-a",
+		"Forgejo: create and write the template&#39;s initial content to the private repository kilgore/app-a",
+		"kilgore/app-a-gitops-preflight", "kilgore/app-a-gitops-production",
+		"Forgejo: configure the webhook of kilgore/app-a that sends push events to " + dlgWebhookBase + "app-id-app-a"} {
+		require.Contains(t, page, want)
+	}
+
+	// Approved but not completed: no tool token yet.
+	cb := e.approve(approval, "approve")
+	require.Equal(t, "st", cb.Query().Get("state"))
+	rr := e.derive(handle, dlgAudience, details[:1])
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Equal(t, "invalid_grant", errorOf(t, rr))
+
+	// A wrong PKCE verifier does not complete it.
+	code := cb.Query().Get("code")
+	require.Equal(t, http.StatusBadRequest, e.redeem(code, newPKCE()).Code)
+
+	rr = e.redeem(code, pk)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var tr struct {
+		AccessToken          string          `json:"access_token"`
+		RefreshToken         string          `json:"refresh_token"`
+		AuthorizationDetails json.RawMessage `json:"authorization_details"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &tr))
+	canonical, _ := delegation.Canonical([]byte(raw))
+	require.JSONEq(t, string(canonical), string(tr.AuthorizationDetails))
+	require.Equal(t, dlgCLI, jwtClaims(t, tr.AccessToken)["aud"], "the CLI's own token is unchanged")
+
+	// One Step: the source repository only.
+	rr = e.derive(handle, dlgAudience, details[:1])
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var dr struct {
+		AccessToken          string          `json:"access_token"`
+		IssuedTokenType      string          `json:"issued_token_type"`
+		ExpiresIn            int             `json:"expires_in"`
+		RefreshToken         string          `json:"refresh_token"`
+		AuthorizationDetails json.RawMessage `json:"authorization_details"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &dr))
+	require.Empty(t, dr.RefreshToken)
+	require.Equal(t, "urn:ietf:params:oauth:token-type:access_token", dr.IssuedTokenType)
+	require.Equal(t, 300, dr.ExpiresIn)
+	c := jwtClaims(t, dr.AccessToken)
+	require.Equal(t, dlgAudience, c["aud"])
+	require.Equal(t, dlgTCP, c["azp"])
+	require.Equal(t, e.subject, c["sub"])
+	require.Equal(t, e.issuer, c["iss"])
+	require.Equal(t, id, c["pathops_grant"])
+	require.EqualValues(t, 300, c["exp"].(float64)-c["iat"].(float64))
+	one, _ := delegation.Canonical([]byte(mustJSON(t, details[:1])))
+	require.JSONEq(t, string(one), mustJSON(t, c["authorization_details"]))
+
+	// The webhook Step gets only the webhook detail.
+	rr = e.derive(handle, dlgAudience, details[3:])
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &dr))
+	require.Len(t, jwtClaims(t, dr.AccessToken)["authorization_details"], 1)
+	require.Equal(t, "pathops_webhook", jwtClaims(t, dr.AccessToken)["authorization_details"].([]any)[0].(map[string]any)["type"])
+
+	// Negative derivations.
+	other := dlgDetails("kilgore", "app-b", "app-id-app-b")
+	otherUser, err := tokens.GenSubject("someone-else", "mock")
+	require.NoError(t, err)
+	widened := []map[string]any{{"type": "pathops_repository", "version": 1, "tool": "forgejo", "owner": "kilgore",
+		"repository": "app-a", "actions": []string{"create", "delete", "seed"}}}
+	for name, tc := range map[string]struct {
+		handle, audience string
+		details          []map[string]any
+		basic            []string
+		code             int
+		err              string
+	}{
+		"public client":         {handle, dlgAudience, details[:1], []string{dlgCLI, ""}, 400, "unauthorized_client"},
+		"wrong secret":          {handle, dlgAudience, details[:1], []string{dlgTCP, "nope"}, 401, "invalid_client"},
+		"not a delegate":        {handle, dlgAudience, details[:1], []string{dlgOther, "other-secret"}, 400, "unauthorized_client"},
+		"another application":   {handle, dlgAudience, other[:1], nil, 400, "invalid_authorization_details"},
+		"another app's webhook": {handle, dlgAudience, other[3:], nil, 400, "invalid_authorization_details"},
+		"widened action":        {handle, dlgAudience, widened, nil, 400, "invalid_authorization_details"},
+		"empty":                 {handle, dlgAudience, []map[string]any{}, nil, 400, "invalid_authorization_details"},
+		"wrong audience":        {handle, "u:8:2f0c6a51-8d7e-4b8e-9c55-3a2f0e9b1c44", details[:1], nil, 400, "invalid_target"},
+		"unknown grant":         {delegation.Handle("plan-nope-00000000", e.subject), dlgAudience, details[:1], nil, 400, "invalid_grant"},
+		"another user's handle": {delegation.Handle(id, otherUser), dlgAudience, details[:1], nil, 400, "invalid_grant"},
+		"user token as subject": {tr.AccessToken, dlgAudience, details[:1], nil, 400, "invalid_grant"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			rr := e.derive(tc.handle, tc.audience, tc.details, tc.basic...)
+			require.Equal(t, tc.code, rr.Code, rr.Body.String())
+			require.Equal(t, tc.err, errorOf(t, rr))
+		})
+	}
+
+	// The grant expires: no more tokens; a token never outlives the grant.
+	*e.clock = e.clock.Add(13 * time.Minute)
+	rr = e.derive(handle, dlgAudience, details[1:2])
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &dr))
+	require.Equal(t, 120, dr.ExpiresIn)
+	*e.clock = e.clock.Add(3 * time.Minute)
+	rr = e.derive(handle, dlgAudience, details[1:2])
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Contains(t, rr.Body.String(), "expired")
+}
+
+func TestDelegationOperationsAreSeparate(t *testing.T) {
+	e := newDelegationEnv(t)
+	idA, detailsA := e.granted("app-a")
+	idB, detailsB := e.granted("app-b")
+	require.NotEqual(t, idA, idB)
+
+	hA, hB := delegation.Handle(idA, e.subject), delegation.Handle(idB, e.subject)
+	require.Equal(t, http.StatusOK, e.derive(hA, dlgAudience, detailsA[:1]).Code)
+	require.Equal(t, http.StatusOK, e.derive(hB, dlgAudience, detailsB[:1]).Code)
+	for i := range detailsB {
+		rr := e.derive(hA, dlgAudience, detailsB[i:i+1])
+		require.Equal(t, "invalid_authorization_details", errorOf(t, rr), "app-a's grant must not cover %v", detailsB[i])
+	}
+}
