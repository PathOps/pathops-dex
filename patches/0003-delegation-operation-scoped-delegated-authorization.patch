+// completeDelegation activates the operation grant of a code issued for a
+// PathOps Authorization Plan: the plan's client redeemed it with the PKCE
+// verifier of the plan's challenge. The response carries the approved
+// authorization_details; the tokens themselves are the client's usual ones.
+func (g *authorizationCode) completeDelegation(ctx context.Context, authCode storage.AuthCode, auth tokens.Authorization, withRefresh bool) (Responder, error) {
+	d, err := delegation.DecodeRequest(authCode.Delegation)
+	if err != nil || d == nil || g.delegation == nil {
+		g.logger.ErrorContext(ctx, "auth code with unusable delegation state", "err", err)
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	grant, err := g.delegation.Activate(ctx, g.storage, &d.Plan, g.now())
+	if err != nil {
+		g.logger.InfoContext(ctx, "operation grant not activated", "plan", d.Plan.ID, "err", err)
+		return nil, &oauth2.Error{Type: oauth2.InvalidGrant, Description: "The operation grant cannot be completed: " + err.Error(), Status: http.StatusBadRequest}
+	}
+	g.logger.InfoContext(ctx, "operation grant active", "plan", d.Plan.ID, "delegate", d.Plan.Delegate,
+		"application", d.Plan.Application.Name, "run", d.Plan.Run.ID, "expires_at", grant.ExpiresAt.Format(time.RFC3339))
+	resp, err := g.issuer.IssueResponse(ctx, auth, authCode.ID, withRefresh)
+	if err != nil {
+		g.logger.ErrorContext(ctx, "failed to issue tokens", "err", err)
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	resp.AuthorizationDetails = d.Plan.Details
+	return resp, nil
+}
