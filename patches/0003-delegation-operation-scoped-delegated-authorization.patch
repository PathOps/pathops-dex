+}
+
+// parseAuthorizationParams validates authorization request parameters: those
+// of an /auth request, or (pushed) the body of a pushed authorization request,
+// the only place PathOps authorization_details are accepted.
+func (h *Handler) parseAuthorizationParams(ctx context.Context, q url.Values, pushed bool) (*storage.AuthRequest, string, error) {
 	// r.ParseForm already URL-decodes query values once; decoding redirect_uri a
 	// second time created a normalization differential with the token endpoint.
 	redirectURI := q.Get("redirect_uri")
@@ -237,6 +246,12 @@ func (h *Handler) parseAuthorizationRequest(r *http.Request) (*storage.AuthReque
 		}
 	}
 
+	// Rich authorization requests (PathOps delegation) must be pushed (PAR), so
+	// the signed plan and its details never travel through the browser.
+	if !pushed && (q.Get(delegation.DetailsParam) != "" || q.Get(delegation.PlanParam) != "") {
+		return nil, "", newredirectedAuthErr(oauth2.InvalidRequest, "authorization_details must be sent in a pushed authorization request.")
+	}
+
 	// dex doesn't support the request parameter and must return request_not_supported.
 	// https://openid.net/specs/openid-connect-core-1_0.html#6.1
 	if q.Get("request") != "" {
@@ -382,3 +397,39 @@ func (h *Handler) parseAuthorizationRequest(r *http.Request) (*storage.AuthReque
 		HMACKey: storage.NewHMACKey(crypto.SHA256),
 	}, idTokenHintSubject, nil
 }
+
+// errPushedUnusable is shown for a request_uri that cannot start a flow.
+const errPushedUnusable = "The request_uri is unknown, expired or already used."
+
+// pushedAuthorizationRequest resolves an /auth request_uri (RFC 9126 §4) to a
+// new authorization request with the pushed parameters, which replace every
+// other parameter of the request. The pushed request is consumed when the new
+// request is stored (handleConnectorLogin), so a request_uri starts at most
+// one flow.
+func (h *Handler) pushedAuthorizationRequest(ctx context.Context, q url.Values) (*storage.AuthRequest, string, error) {
+	id, ok := strings.CutPrefix(q.Get("request_uri"), delegation.RequestURIPrefix)
+	if !ok || id == "" || h.Delegation == nil {
+		return nil, "", newDisplayedErr(http.StatusBadRequest, errPushedUnusable)
+	}
+	pushed, err := h.Storage.GetAuthRequest(ctx, id)
+	if err != nil {
+		if err != storage.ErrNotFound {
+			h.Logger.ErrorContext(ctx, "failed to get pushed authorization request", "err", err)
+			return nil, "", newDisplayedErr(http.StatusInternalServerError, "Database error.")
+		}
+		return nil, "", newDisplayedErr(http.StatusBadRequest, errPushedUnusable)
+	}
+	d, err := delegation.DecodeRequest(pushed.Delegation)
+	if err != nil || d == nil || !d.Pushed || !h.Now().Before(pushed.Expiry) {
+		return nil, "", newDisplayedErr(http.StatusBadRequest, errPushedUnusable)
+	}
+	if q.Get("client_id") != pushed.ClientID {
+		return nil, "", newDisplayedErr(http.StatusBadRequest, "client_id does not match the request_uri.")
+	}
+	req := pushed
+	req.ID = storage.NewID()
+	req.HMACKey = storage.NewHMACKey(crypto.SHA256)
+	d.Pushed, d.PushedID = false, pushed.ID
+	req.Delegation = d.Encode()
+	return &req, "", nil
+}
