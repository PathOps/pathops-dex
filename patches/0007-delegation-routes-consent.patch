+// TestConsentRoutes: PathOps Routes (Decision 0067) show their hostnames, and
+// the Routes parameter object its exact allowed hostnames and the update.
+func TestConsentRoutes(t *testing.T) {
+	p, err := NewPolicy(validConfig())
+	require.NoError(t, err)
+	got := p.Consent(&Plan{Delegate: "pathops-tenant-control-plane", Details: []byte(`[
+		{"type":"pathops_route","tool":"pathops","application":"x","name":"api-shop","default":true,
+		 "hosts":{"preflight":"api-shop-preflight-c1.example","production":"api-shop-production-c1.example"},"actions":["reserve"]},
+		{"type":"pathops_kubernetes_resource","tool":"kubernetes","application":"x","apiGroup":"","resource":"configmaps",
+		 "namespace":"a-preflight-deploy","name":"pathops-routes","allowedHosts":["api-shop-preflight-c1.example"],"actions":["update"]}]`)})
+	require.Len(t, got.Tools, 2)
+	require.Equal(t, []ConsentRoute{{Name: "api-shop", Application: "x", Default: true,
+		Hosts:   []ConsentHost{{"preflight", "api-shop-preflight-c1.example"}, {"production", "api-shop-production-c1.example"}},
+		Actions: []ConsentAction{{"reserve", "reserve this name and its hostnames for the application"}}}}, got.Tools[0].Routes)
+	require.Empty(t, got.Tools[0].Other)
+	require.Equal(t, []ConsentKubernetesResource{{Kind: "configmaps", Name: "a-preflight-deploy/pathops-routes", Application: "x",
+		Actions:      []ConsentAction{{"update", "replace this object's content with the content shown"}},
+		AllowedHosts: []string{"api-shop-preflight-c1.example"}}}, got.Tools[1].KubernetesResources)
+}
diff --git a/server/delegation/plan.go b/server/delegation/plan.go
index e302a16..2ff4ca1 100644
--- a/server/delegation/plan.go
+++ b/server/delegation/plan.go
@@ -359,6 +359,9 @@ type ConsentTool struct {
 	RepositoryTokens    []ConsentRepositoryToken
 	DeployKeys          []ConsentDeployKey
 	KubernetesResources []ConsentKubernetesResource
+	// Routes are the PathOps Routes the operation reserves (Decision
+	// 0067): a name and its hostname in each Environment.
+	Routes []ConsentRoute
 	// Other are details of other types, described generically.
 	Other []string
 }
@@ -385,6 +388,23 @@ type ConsentKubernetesResource struct {
 	// namespaced object.
 	Kind, Name, Application string
 	Actions                 []ConsentAction
+	// AllowedHosts are the hostnames the object admits, when it is a PathOps
+	// Routes parameter (the exact content the operation writes).
+	AllowedHosts []string
+}
+
+// ConsentRoute is one Route detail: an external name reserved for an
+// Application, with its hostname in each Environment.
+type ConsentRoute struct {
+	Name, Application string
+	Default           bool
+	Hosts             []ConsentHost
+	Actions           []ConsentAction
+}
+
+// ConsentHost is a Route's hostname in one Environment.
+type ConsentHost struct {
+	Environment, Host string
 }
 
 // ConsentRepository is one repository detail.
@@ -417,6 +437,10 @@ var typeActionMeanings = map[string]map[string]string{
 	},
 	"pathops_kubernetes_resource": {
 		"create": "create this object",
+		"update": "replace this object's content with the content shown",
+	},
+	"pathops_route": {
+		"reserve": "reserve this name and its hostnames for the application",
 	},
 }
 
@@ -495,7 +519,19 @@ func (p *Policy) Consent(pl *Plan) Consent {
 				name = ns + "/" + name
 			}
 			t.KubernetesResources = append(t.KubernetesResources, ConsentKubernetesResource{Kind: kind, Name: name,
-				Application: str("application"), Actions: typedConsentActions(dt.Type, dt.Actions)})
+				Application: str("application"), Actions: typedConsentActions(dt.Type, dt.Actions),
+				AllowedHosts: optionalList(m["allowedHosts"])})
+		case "pathops_route":
+			isDefault, _ := m["default"].(bool)
+			r := ConsentRoute{Name: str("name"), Application: str("application"), Default: isDefault,
+				Actions: typedConsentActions(dt.Type, dt.Actions)}
+			hosts, _ := m["hosts"].(map[string]any)
+			for _, env := range []string{"preflight", "production"} {
+				if h, ok := hosts[env].(string); ok {
+					r.Hosts = append(r.Hosts, ConsentHost{Environment: env, Host: h})
+				}
+			}
+			t.Routes = append(t.Routes, r)
 		default:
 			t.Other = append(t.Other, describe(dt, m))
 		}
@@ -519,6 +555,14 @@ func describe(dt detail, m map[string]any) string {
 	return strings.Join(parts, " ")
 }
 
+// optionalList is stringList, nil when v is absent.
+func optionalList(v any) []string {
+	if v == nil {
+		return nil
+	}
+	return stringList(v)
+}
+
 // stringList is a JSON array's elements as strings.
 func stringList(v any) []string {
 	list, _ := v.([]any)
diff --git a/server/templates/templates_test.go b/server/templates/templates_test.go
index 627f5a5..4030b46 100644
--- a/server/templates/templates_test.go
+++ b/server/templates/templates_test.go
@@ -142,3 +142,34 @@ func TestDelegationTemplateBuildAndPush(t *testing.T) {
 		t.Error("BUILD_AND_PUSH details are shown as other resources")
 	}
 }
+
+// The bundled consent screen shows Routes with their hostnames and a Routes
+// parameter's allowed hostnames (PathOps Decision 0067).
+func TestDelegationTemplateRoutes(t *testing.T) {
+	_, _, _, tmpls, err := LoadWebConfig(Config{WebFS: os.DirFS("../../web"), Issuer: "dex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	page := DelegationPage{User: "gaston", Delegate: "PathOps Tenant Control Plane", Consent: delegation.Consent{Tools: []delegation.ConsentTool{
+		{Name: "pathops", DisplayName: "PathOps",
+			Routes: []delegation.ConsentRoute{{Name: "api-shop", Default: true, Hosts: []delegation.ConsentHost{
+				{Environment: "preflight", Host: "api-shop-preflight-c1.example"}, {Environment: "production", Host: "api-shop-production-c1.example"}}}}},
+		{Name: "kubernetes", DisplayName: "Kubernetes",
+			KubernetesResources: []delegation.ConsentKubernetesResource{{Kind: "configmaps", Name: "a-preflight-deploy/pathops-routes",
+				AllowedHosts: []string{"api-shop-preflight-c1.example"}}}},
+	}}}
+	rr := httptest.NewRecorder()
+	if err := tmpls.Delegation(httptest.NewRequest(http.MethodGet, "/approval", nil), rr, page); err != nil {
+		t.Fatal(err)
+	}
+	body := rr.Body.String()
+	for _, want := range []string{"Routes", "api-shop", "default", "api-shop-preflight-c1.example", "api-shop-production-c1.example",
+		"Allowed hostnames", "a-preflight-deploy/pathops-routes"} {
+		if !strings.Contains(body, want) {
+			t.Errorf("the consent screen does not show %q", want)
+		}
+	}
+	if strings.Contains(body, "Other resources") {
+		t.Error("Routes are shown as other resources")
+	}
+}
