+// TestConsentRoutes: PathOps Routes (Decision 0067) show their hostnames, and
+// the Routes parameter object its exact allowed hostnames and the update.
+func TestConsentRoutes(t *testing.T) {
+	p, err := NewPolicy(validConfig())
+	require.NoError(t, err)
+	got := p.Consent(&Plan{Delegate: "pathops-tenant-control-plane", Details: []byte(`[
+		{"type":"pathops_route","tool":"pathops","application":"x","name":"api-shop","default":true,
+		 "hosts":{"preflight":"api-shop-preflight-c1.example","production":"api-shop-production-c1.example"},"actions":["reserve"]},
+		{"type":"pathops_kubernetes_resource","tool":"kubernetes","application":"x","apiGroup":"","resource":"configmaps",
+		 "namespace":"a-preflight-deploy","name":"pathops-routes","allowedHosts":["api-shop-preflight-c1.example"],"actions":["update"]}]`)})
+	require.Len(t, got.Tools, 2)
+	require.Equal(t, []ConsentRoute{{Name: "api-shop", Application: "x", Default: true,
+		Hosts:   []ConsentHost{{"preflight", "api-shop-preflight-c1.example"}, {"production", "api-shop-production-c1.example"}},
+		Actions: []ConsentAction{{"reserve", "reserve this name and its hostnames for the application"}}}}, got.Tools[0].Routes)
+	require.Empty(t, got.Tools[0].Other)
+	require.Equal(t, []ConsentKubernetesResource{{Kind: "configmaps", Name: "a-preflight-deploy/pathops-routes", Application: "x",
+		Actions:      []ConsentAction{{"update", "replace this object's content with the content shown"}},
+		AllowedHosts: []string{"api-shop-preflight-c1.example"}}}, got.Tools[1].KubernetesResources)
+}
