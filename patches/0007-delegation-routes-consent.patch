 server/delegation/delegation_test.go | 20 ++++++++++++
 server/delegation/plan.go            | 46 +++++++++++++++++++++++++++-
 server/templates/templates_test.go   | 31 +++++++++++++++++++
 web/templates/delegation.html        | 23 ++++++++++++++
 5 files changed, 120 insertions(+), 1 deletion(-)

