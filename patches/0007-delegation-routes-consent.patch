+
+// The bundled consent screen shows Routes with their hostnames and a Routes
+// parameter's allowed hostnames (PathOps Decision 0067).
+func TestDelegationTemplateRoutes(t *testing.T) {
+	_, _, _, tmpls, err := LoadWebConfig(Config{WebFS: os.DirFS("../../web"), Issuer: "dex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	page := DelegationPage{User: "gaston", Delegate: "PathOps Tenant Control Plane", Consent: delegation.Consent{Tools: []delegation.ConsentTool{
+		{Name: "pathops", DisplayName: "PathOps",
+			Routes: []delegation.ConsentRoute{{Name: "api-shop", Default: true, Hosts: []delegation.ConsentHost{
+				{Environment: "preflight", Host: "api-shop-preflight-c1.example"}, {Environment: "production", Host: "api-shop-production-c1.example"}}}}},
+		{Name: "kubernetes", DisplayName: "Kubernetes",
+			KubernetesResources: []delegation.ConsentKubernetesResource{{Kind: "configmaps", Name: "a-preflight-deploy/pathops-routes",
+				AllowedHosts: []string{"api-shop-preflight-c1.example"}}}},
+	}}}
+	rr := httptest.NewRecorder()
+	if err := tmpls.Delegation(httptest.NewRequest(http.MethodGet, "/approval", nil), rr, page); err != nil {
+		t.Fatal(err)
+	}
+	body := rr.Body.String()
+	for _, want := range []string{"Routes", "api-shop", "default", "api-shop-preflight-c1.example", "api-shop-production-c1.example",
+		"Allowed hostnames", "a-preflight-deploy/pathops-routes"} {
+		if !strings.Contains(body, want) {
+			t.Errorf("the consent screen does not show %q", want)
+		}
+	}
+	if strings.Contains(body, "Other resources") {
+		t.Error("Routes are shown as other resources")
+	}
+}
