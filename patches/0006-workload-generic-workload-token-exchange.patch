diff --git a/server/grants/workload.go b/server/grants/workload.go
new file mode 100644
index 0000000..702d2a1
--- /dev/null
+++ b/server/grants/workload.go
@@ -0,0 +1,98 @@
+package grants
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"net/http"
+	"time"
+
+	"github.com/dexidp/dex/connector"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/server/workload"
+	"github.com/dexidp/dex/storage"
+)
+
+// workloadGrantType is the internal key of the PathOps generic workload token
+// exchange: an RFC 8693 token exchange with an actor_token.
+const workloadGrantType = "pathops:workload-exchange"
+
+// workloadExchange issues a short-lived token of a configured audience for a
+// workload subject token, on the authority of a bound actor token
+// (workload.Exchanger). Only configured confidential clients may ask.
+type workloadExchange struct {
+	exchanger *workload.Exchanger
+	logger    *slog.Logger
+}
+
+func (g *workloadExchange) GrantType() string { return workloadGrantType }
+
+// ConnectorGrantType: toward the subject connector the workload exchange is
+// an RFC 8693 token exchange, so a connector limited to it (grantTypes:
+// [urn:ietf:params:oauth:grant-type:token-exchange]) serves it.
+func (g *workloadExchange) ConnectorGrantType() string { return oauth2.GrantTypeTokenExchange }
+
+func (g *workloadExchange) RequiresClientAuth() bool { return true }
+
+// ScopePolicy passes scopes through: an issued token carries no scope.
+func (g *workloadExchange) ScopePolicy() ScopePolicy { return ScopePolicy{} }
+
+// ConnectorID is the configured subject connector; a request naming another
+// one is refused.
+func (g *workloadExchange) ConnectorID(_ context.Context, req *Request, _ storage.Client) (string, *oauth2.Error) {
+	if req.ConnectorID != "" && req.ConnectorID != g.exchanger.Connector() {
+		return "", &oauth2.Error{Type: oauth2.InvalidRequest, Description: "connector_id is not the workload subject connector",
+			Status: http.StatusBadRequest}
+	}
+	return g.exchanger.Connector(), nil
+}
+
+func (g *workloadExchange) Authorize(ctx context.Context, req *Request, client storage.Client, conn connectors.Connector) (Responder, error) {
+	denied := &oauth2.Error{Type: oauth2.AccessDenied, Status: http.StatusForbidden}
+	if client.Public || !g.exchanger.Client(client.ID) {
+		g.logger.WarnContext(ctx, "workload token exchange refused: client", "client_id", client.ID)
+		return nil, &oauth2.Error{Type: "unauthorized_client", Description: "this client may not exchange workload tokens",
+			Status: http.StatusBadRequest}
+	}
+	switch {
+	case req.SubjectTokenType != oauth2.TokenTypeID:
+		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "subject_token_type must be an ID token", Status: http.StatusBadRequest}
+	case req.ActorTokenType != workload.ActorTokenType:
+		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "actor_token_type must be a JWT", Status: http.StatusBadRequest}
+	case req.SubjectToken == "" || req.ActorToken == "" || req.Audience == "":
+		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "subject_token, actor_token and audience are required",
+			Status: http.StatusBadRequest}
+	case req.RequestedTokenType != "" && req.RequestedTokenType != workload.IssuedTokenType:
+		return nil, &oauth2.Error{Type: oauth2.InvalidRequest, Description: "requested_token_type must be a JWT", Status: http.StatusBadRequest}
+	}
+	teConn, ok := conn.Connector.(connector.TokenIdentityConnector)
+	if !ok {
+		g.logger.ErrorContext(ctx, "workload subject connector does not verify tokens", "connector_id", g.exchanger.Connector())
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	identity, err := teConn.TokenIdentity(ctx, req.SubjectTokenType, req.SubjectToken)
+	if err != nil {
+		g.logger.WarnContext(ctx, "workload token exchange refused: subject token", "client_id", client.ID, "err", err)
+		return nil, denied
+	}
+	issued, err := g.exchanger.Exchange(req.SubjectToken, identity.UserID, req.ActorToken, req.Audience)
+	if errors.Is(err, workload.ErrDenied) {
+		g.logger.WarnContext(ctx, "workload token exchange refused", "client_id", client.ID, "user_id", identity.UserID,
+			"audience", req.Audience, "err", err)
+		return nil, denied
+	}
+	if err != nil {
+		g.logger.ErrorContext(ctx, "workload token exchange failed", "client_id", client.ID, "err", err)
+		return nil, &oauth2.Error{Type: oauth2.ServerError, Status: http.StatusInternalServerError}
+	}
+	g.logger.InfoContext(ctx, "workload token issued", "client_id", client.ID, "actor", issued.Actor, "user_id", identity.UserID,
+		"audience", issued.Audience, "expiry", issued.Expiry.Format(time.RFC3339))
+	return tokens.Response{
+		AccessToken:     issued.Token,
+		IssuedTokenType: workload.IssuedTokenType,
+		TokenType:       "bearer",
+		ExpiresIn:       int(time.Until(issued.Expiry).Seconds()),
+	}, nil
+}
diff --git a/server/grants/workload_test.go b/server/grants/workload_test.go
new file mode 100644
index 0000000..feb7062
--- /dev/null
+++ b/server/grants/workload_test.go
@@ -0,0 +1,271 @@
+package grants
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-jose/go-jose/v4"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/connector/oidc"
+	"github.com/dexidp/dex/server/connectors"
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/server/workload"
+	"github.com/dexidp/dex/storage"
+)
+
+// kubernetesIssuer is a stand-in for a Cell's Kubernetes ServiceAccount
+// issuer: OIDC discovery and JWKS over HTTP, RS256 tokens.
+type kubernetesIssuer struct {
+	srv *httptest.Server
+	key *rsa.PrivateKey
+}
+
+func newKubernetesIssuer(t *testing.T) *kubernetesIssuer {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	k := &kubernetesIssuer{key: key}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/.well-known/openid-configuration", func(w http.ResponseWriter, _ *http.Request) {
+		json.NewEncoder(w).Encode(map[string]any{"issuer": k.srv.URL, "jwks_uri": k.srv.URL + "/openid/v1/jwks",
+			"authorization_endpoint": k.srv.URL + "/authorize", "token_endpoint": k.srv.URL + "/token",
+			"id_token_signing_alg_values_supported": []string{"RS256"}, "response_types_supported": []string{"id_token"},
+			"subject_types_supported": []string{"public"}})
+	})
+	mux.HandleFunc("/openid/v1/jwks", func(w http.ResponseWriter, _ *http.Request) {
+		json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &key.PublicKey, KeyID: "k8s-1", Algorithm: "RS256", Use: "sig"}}})
+	})
+	k.srv = httptest.NewServer(mux)
+	t.Cleanup(k.srv.Close)
+	return k
+}
+
+// token is a ServiceAccount token of subject for audience, valid until exp,
+// signed with key (nil: the issuer's key).
+func (k *kubernetesIssuer) token(t *testing.T, subject, audience string, exp time.Time, key *rsa.PrivateKey) string {
+	if key == nil {
+		key = k.key
+	}
+	s, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: jose.JSONWebKey{Key: key, KeyID: "k8s-1"}}, nil)
+	require.NoError(t, err)
+	now := time.Now()
+	body, _ := json.Marshal(map[string]any{"iss": k.srv.URL, "sub": subject, "aud": []string{audience},
+		"iat": now.Add(-time.Minute).Unix(), "nbf": now.Add(-time.Minute).Unix(), "exp": exp.Unix()})
+	jws, err := s.Sign(body)
+	require.NoError(t, err)
+	out, err := jws.CompactSerialize()
+	require.NoError(t, err)
+	return out
+}
+
+const (
+	exchangeAudience = "pathops-workload-exchange"
+	actorIssuer      = "pathops-tenant-control-plane"
+	appA             = "11111111-1111-4111-8111-111111111111"
+	saA              = "system:serviceaccount:a-build:a-build"
+)
+
+type actorKey struct {
+	kid string
+	key ed25519.PrivateKey
+}
+
+// actor signs an actor token with claims over the defaults.
+func (a actorKey) sign(t *testing.T, claims map[string]any) string {
+	now := time.Now()
+	c := map[string]any{"iss": actorIssuer, "aud": exchangeAudience, "iat": now.Unix(), "exp": now.Add(2 * time.Minute).Unix()}
+	for k, v := range claims {
+		if v == nil {
+			delete(c, k)
+		} else {
+			c[k] = v
+		}
+	}
+	h, _ := json.Marshal(map[string]string{"alg": "EdDSA", "typ": "JWT", "kid": a.kid})
+	b, _ := json.Marshal(c)
+	in := base64.RawURLEncoding.EncodeToString(h) + "." + base64.RawURLEncoding.EncodeToString(b)
+	return in + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(a.key, []byte(in)))
+}
+
+func hashOf(token string) string {
+	s := sha256.Sum256([]byte(token))
+	return base64.RawURLEncoding.EncodeToString(s[:])
+}
+
+func claimsOf(t *testing.T, token string) map[string]any {
+	parts := strings.Split(token, ".")
+	require.Len(t, parts, 3)
+	raw, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	var c map[string]any
+	require.NoError(t, json.Unmarshal(raw, &c))
+	return c
+}
+
+// TestWorkloadExchange runs the grant with a real OIDC connector (the
+// PathOps subjectTokenAudiences check) against a Kubernetes-like issuer: the
+// subject token's signature, issuer, audience and expiry are the connector's;
+// the actor token's and the binding are the exchanger's. Nothing reaches a
+// Kubernetes API: the issuer serves only discovery and JWKS.
+func TestWorkloadExchange(t *testing.T) {
+	k8s := newKubernetesIssuer(t)
+	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+	// Not in a cluster: no Kubernetes API is reachable from this test.
+	t.Setenv("KUBERNETES_SERVICE_HOST", "")
+	conn, err := (&oidc.Config{Issuer: k8s.srv.URL, ClientID: exchangeAudience, SubjectTokenAudiences: []string{exchangeAudience},
+		UserIDKey: "sub", UserNameKey: "sub", Scopes: []string{"openid"}}).Open("k8s-cell", logger)
+	require.NoError(t, err)
+
+	pubA, privA, _ := ed25519.GenerateKey(rand.Reader)
+	_, rogue, _ := ed25519.GenerateKey(rand.Reader)
+	_, outKey, _ := ed25519.GenerateKey(rand.Reader)
+	_, artKey, _ := ed25519.GenerateKey(rand.Reader)
+	ex, err := workload.NewWithKeys(workload.Config{
+		Clients:          []string{"pathops-tenant-control-plane"},
+		SubjectConnector: "k8s-cell",
+		Actors: []workload.ActorConfig{{Issuer: actorIssuer, Audience: exchangeAudience,
+			Keys: []workload.KeyConfig{{KeyID: "tcp-workload-1", Ed25519: base64.RawURLEncoding.EncodeToString(pubA)}}}},
+		Outputs: []workload.OutputConfig{
+			{Audience: "pathops-registry", Issuer: "https://dex.example.org/registry", KeyID: "registry-1", MaxLifetime: "30m",
+				Claims: []string{"access", "pathops_application"}},
+			{Audience: "pathops-artifact-store", Issuer: "https://dex.example.org/artifacts", KeyID: "artifact-1", MaxLifetime: "5m",
+				Claims: []string{"pathops_application", "pathops_operations"}},
+		},
+	}, map[string]ed25519.PrivateKey{"pathops-registry": outKey, "pathops-artifact-store": artKey})
+	require.NoError(t, err)
+	g := &workloadExchange{exchanger: ex, logger: logger}
+	tcp := storage.Client{ID: "pathops-tenant-control-plane", Secret: "s"}
+	actor := actorKey{kid: "tcp-workload-1", key: privA}
+
+	subject := k8s.token(t, saA, exchangeAudience, time.Now().Add(10*time.Minute), nil)
+	authz := map[string]any{"pathops_application": appA,
+		"access":  []any{map[string]any{"type": "repository", "name": "apps/" + appA, "actions": []any{"pull", "push"}}},
+		"ignored": "not copied"}
+	good := map[string]any{"subject_token_hash": hashOf(subject), "target_audience": "pathops-registry", "authorization": authz}
+
+	request := func(subject, actorToken, audience string) *Request {
+		return &Request{SubjectToken: subject, SubjectTokenType: oauth2.TokenTypeID, ActorToken: actorToken,
+			ActorTokenType: workload.ActorTokenType, Audience: audience}
+	}
+	call := func(req *Request, client storage.Client) (tokens.Response, error) {
+		resp, err := g.Authorize(t.Context(), req, client, connectors.Connector{Connector: conn})
+		if err != nil {
+			return tokens.Response{}, err
+		}
+		return resp.(tokens.Response), nil
+	}
+	deny := func(t *testing.T, req *Request, client storage.Client) {
+		t.Helper()
+		_, err := call(req, client)
+		var oe *oauth2.Error
+		require.ErrorAs(t, err, &oe)
+		require.NotEqual(t, http.StatusOK, oe.Status)
+	}
+	with := func(over map[string]any) map[string]any {
+		c := map[string]any{}
+		for k, v := range good {
+			c[k] = v
+		}
+		for k, v := range over {
+			c[k] = v
+		}
+		return c
+	}
+
+	t.Run("valid subject, valid actor, matching hash: a token of the output audience", func(t *testing.T) {
+		res, err := call(request(subject, actor.sign(t, good), "pathops-registry"), tcp)
+		require.NoError(t, err)
+		require.Equal(t, workload.IssuedTokenType, res.IssuedTokenType)
+		require.LessOrEqual(t, res.ExpiresIn, 1800)
+		require.Greater(t, res.ExpiresIn, 1700)
+		c := claimsOf(t, res.AccessToken)
+		require.Equal(t, "https://dex.example.org/registry", c["iss"])
+		require.Equal(t, "pathops-registry", c["aud"])
+		require.Equal(t, saA, c["sub"])
+		require.Equal(t, appA, c["pathops_application"])
+		require.Equal(t, authz["access"], c["access"])
+		require.NotContains(t, c, "ignored")
+		require.NotContains(t, c, "authorization")
+		parts := strings.Split(res.AccessToken, ".")
+		sig, _ := base64.RawURLEncoding.DecodeString(parts[2])
+		require.True(t, ed25519.Verify(outKey.Public().(ed25519.PublicKey), []byte(parts[0]+"."+parts[1]), sig))
+	})
+	t.Run("the actor may ask for a shorter lifetime, never a longer one", func(t *testing.T) {
+		res, err := call(request(subject, actor.sign(t, with(map[string]any{"token_lifetime": 300})), "pathops-registry"), tcp)
+		require.NoError(t, err)
+		require.LessOrEqual(t, res.ExpiresIn, 300)
+		res, err = call(request(subject, actor.sign(t, with(map[string]any{"token_lifetime": 7200})), "pathops-registry"), tcp)
+		require.NoError(t, err)
+		require.LessOrEqual(t, res.ExpiresIn, 1800)
+	})
+	t.Run("invalid subject signature", func(t *testing.T) {
+		other, _ := rsa.GenerateKey(rand.Reader, 2048)
+		bad := k8s.token(t, saA, exchangeAudience, time.Now().Add(10*time.Minute), other)
+		deny(t, request(bad, actor.sign(t, with(map[string]any{"subject_token_hash": hashOf(bad)})), "pathops-registry"), tcp)
+	})
+	t.Run("expired subject", func(t *testing.T) {
+		old := k8s.token(t, saA, exchangeAudience, time.Now().Add(-time.Minute), nil)
+		deny(t, request(old, actor.sign(t, with(map[string]any{"subject_token_hash": hashOf(old)})), "pathops-registry"), tcp)
+	})
+	t.Run("subject for another audience", func(t *testing.T) {
+		wrong := k8s.token(t, saA, "https://dex.identity.svc.cluster.local:5556", time.Now().Add(10*time.Minute), nil)
+		deny(t, request(wrong, actor.sign(t, with(map[string]any{"subject_token_hash": hashOf(wrong)})), "pathops-registry"), tcp)
+	})
+	t.Run("invalid actor signature", func(t *testing.T) {
+		deny(t, request(subject, actorKey{kid: "tcp-workload-1", key: rogue}.sign(t, good), "pathops-registry"), tcp)
+		deny(t, request(subject, actorKey{kid: "other", key: privA}.sign(t, good), "pathops-registry"), tcp)
+	})
+	t.Run("expired actor", func(t *testing.T) {
+		past := time.Now().Add(-10 * time.Minute)
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"iat": past.Unix(), "exp": past.Add(2 * time.Minute).Unix()})),
+			"pathops-registry"), tcp)
+	})
+	t.Run("actor lives too long", func(t *testing.T) {
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"exp": time.Now().Add(time.Hour).Unix()})), "pathops-registry"), tcp)
+	})
+	t.Run("actor for another audience or from another issuer", func(t *testing.T) {
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"aud": "pathops-registry"})), "pathops-registry"), tcp)
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"iss": "someone-else"})), "pathops-registry"), tcp)
+	})
+	t.Run("actor hash is not the subject's", func(t *testing.T) {
+		otherSubject := k8s.token(t, "system:serviceaccount:b-build:b-build", exchangeAudience, time.Now().Add(10*time.Minute), nil)
+		// Application B's subject token with Application A's actor token.
+		deny(t, request(otherSubject, actor.sign(t, good), "pathops-registry"), tcp)
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"subject_token_hash": nil})), "pathops-registry"), tcp)
+	})
+	t.Run("actor names another output audience", func(t *testing.T) {
+		deny(t, request(subject, actor.sign(t, good), "pathops-artifact-store"), tcp)
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"target_audience": "unknown"})), "unknown"), tcp)
+	})
+	t.Run("no authorization object", func(t *testing.T) {
+		deny(t, request(subject, actor.sign(t, with(map[string]any{"authorization": nil})), "pathops-registry"), tcp)
+	})
+	t.Run("only configured confidential clients", func(t *testing.T) {
+		deny(t, request(subject, actor.sign(t, good), "pathops-registry"), storage.Client{ID: "zot", Public: true})
+		deny(t, request(subject, actor.sign(t, good), "pathops-registry"), storage.Client{ID: "pathops-cli", Secret: "s"})
+	})
+}
+
+// TestWorkloadPackageHasNoKubernetesAPI: the exchanger never reads Kubernetes
+// objects (PathOps Decision 0065): its source neither reaches an API server
+// nor knows PathOps naming.
+func TestWorkloadPackageHasNoKubernetesAPI(t *testing.T) {
+	src, err := os.ReadFile("../workload/workload.go")
+	require.NoError(t, err)
+	for _, s := range []string{"KUBERNETES_SERVICE", "net/http", "serviceaccount/token", "/api/v1/", "pathops.io/", "-build", "-ci\""} {
+		require.NotContains(t, string(src), s)
+	}
+}
