new file mode 100644
index 0000000..56f4327
--- /dev/null
+++ b/server/server_grant_workload_test.go
@@ -0,0 +1,94 @@
+package server
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/dexidp/dex/server/oauth2"
+	"github.com/dexidp/dex/server/tokens"
+	"github.com/dexidp/dex/server/workload"
+	"github.com/dexidp/dex/storage"
+)
+
+// TestHandleWorkloadTokenExchange: a token exchange with an actor_token is
+// answered only by the workload exchange (not by the upstream grant, which
+// would ignore the actor), and only when it is configured.
+func TestHandleWorkloadTokenExchange(t *testing.T) {
+	pub, priv, _ := ed25519.GenerateKey(rand.Reader)
+	_, out, _ := ed25519.GenerateKey(rand.Reader)
+	ex, err := workload.NewWithKeys(workload.Config{
+		Clients: []string{"tcp"}, SubjectConnector: "mock",
+		Actors: []workload.ActorConfig{{Issuer: "pathops-tenant-control-plane", Audience: "pathops-workload-exchange",
+			Keys: []workload.KeyConfig{{KeyID: "k1", Ed25519: base64.RawURLEncoding.EncodeToString(pub)}}}},
+		Outputs: []workload.OutputConfig{{Audience: "pathops-registry", Issuer: "https://dex.example.org/registry", KeyID: "r1",
+			MaxLifetime: "5m", Claims: []string{"access"}}},
+	}, map[string]ed25519.PrivateKey{"pathops-registry": out})
+	require.NoError(t, err)
+
+	const subject = "subject-token"
+	sum := sha256.Sum256([]byte(subject))
+	now := time.Now()
+	h, _ := json.Marshal(map[string]string{"alg": "EdDSA", "kid": "k1"})
+	b, _ := json.Marshal(map[string]any{"iss": "pathops-tenant-control-plane", "aud": "pathops-workload-exchange",
+		"iat": now.Unix(), "exp": now.Add(time.Minute).Unix(), "subject_token_hash": base64.RawURLEncoding.EncodeToString(sum[:]),
+		"target_audience": "pathops-registry", "authorization": map[string]any{"access": []any{}}})
+	in := base64.RawURLEncoding.EncodeToString(h) + "." + base64.RawURLEncoding.EncodeToString(b)
+	actor := in + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(priv, []byte(in)))
+
+	post := func(t *testing.T, enabled bool, client, secret string, grantTypes ...string) *httptest.ResponseRecorder {
+		httpServer, s := newTestServer(t, func(c *Config) {
+			if enabled {
+				c.Workload = ex
+			}
+			c.Storage.CreateClient(t.Context(), storage.Client{ID: "tcp", Secret: "secret"})
+			c.Storage.CreateClient(t.Context(), storage.Client{ID: "other", Secret: "secret"})
+		})
+		defer httpServer.Close()
+		if grantTypes != nil {
+			require.NoError(t, s.storage.UpdateConnector(t.Context(), "mock", func(c storage.Connector) (storage.Connector, error) {
+				c.GrantTypes = grantTypes
+				return c, nil
+			}))
+			s.connectors.Close("mock")
+		}
+		vals := url.Values{"grant_type": {oauth2.GrantTypeTokenExchange}, "subject_token": {subject},
+			"subject_token_type": {oauth2.TokenTypeID}, "actor_token": {actor}, "actor_token_type": {workload.ActorTokenType},
+			"audience": {"pathops-registry"}, "client_id": {client}, "client_secret": {secret}}
+		rr := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, httpServer.URL+"/token", strings.NewReader(vals.Encode()))
+		req.Header.Set("content-type", "application/x-www-form-urlencoded")
+		s.ServeHTTP(rr, req)
+		return rr
+	}
+
+	rr := post(t, true, "tcp", "secret")
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	var res tokens.Response
+	require.NoError(t, json.NewDecoder(rr.Body).Decode(&res))
+	require.Equal(t, workload.IssuedTokenType, res.IssuedTokenType)
+
+	// A subject connector limited to token exchange (as a Cell's k8s-cell
+	// connector is) serves the workload exchange; one that does not allow
+	// token exchange does not.
+	rr = post(t, true, "tcp", "secret", oauth2.GrantTypeTokenExchange)
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+	rr = post(t, true, "tcp", "secret", oauth2.GrantTypeAuthorizationCode)
+	require.Equal(t, http.StatusBadRequest, rr.Code, rr.Body.String())
+
+	require.Equal(t, http.StatusUnauthorized, post(t, true, "tcp", "wrong").Code)
+	require.Equal(t, http.StatusBadRequest, post(t, true, "other", "secret").Code)
+	rr = post(t, false, "tcp", "secret")
+	require.Equal(t, http.StatusBadRequest, rr.Code)
+	require.Contains(t, rr.Body.String(), "unsupported_grant_type")
+}
diff --git a/server/workload/workload.go b/server/workload/workload.go
new file mode 100644
index 0000000..edbcdb3
--- /dev/null
+++ b/server/workload/workload.go
@@ -0,0 +1,400 @@
+// Package workload is the PathOps generic workload token exchange (PathOps
+// Decision 0065): an RFC 8693 token exchange with both a subject token and
+// an actor token, for a short-lived token of a configured output audience.
+//
+//	subject_token  a workload's token, verified by the configured connector
+//	               (issuer, signature, audience, expiry)
+//	actor_token    a short-lived JWT signed by a trusted actor (an Ed25519 key
+//	               configured here), whose "subject_token_hash" binds it to
+//	               exactly that subject token: base64url(SHA-256(subject_token))
+//	audience       the requested output audience, which the actor must name
+//	               too ("target_audience")
+//
+// The issued token is a JWT signed with the output's own Ed25519 key (never
+// Dex's OIDC keys), with the output's issuer and audience, the subject's
+// identity as "sub", a lifetime of at most the output's maximum (and of at
+// most the actor's "token_lifetime" in seconds, when it asks for less), and
+// the claims the output configuration lists copied unchanged from the
+// actor's "authorization" object.
+//
+// Dex does not interpret those claims: the actor (the PathOps Tenant Control
+// Plane) has already decided them. Dex only proves who signed them, that
+// they belong to this subject token and that they are fresh, and limits the
+// audience and lifetime of what it issues.
+package workload
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/subtle"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+)
+
+// ActorTokenType is the actor_token_type of an actor token (RFC 8693 §3).
+const ActorTokenType = "urn:ietf:params:oauth:token-type:jwt"
+
+// IssuedTokenType is the issued_token_type of an issued token.
+const IssuedTokenType = "urn:ietf:params:oauth:token-type:jwt"
+
+// Actor token claims with a meaning here.
+const (
+	ClaimSubjectTokenHash = "subject_token_hash"
+	ClaimTargetAudience   = "target_audience"
+	ClaimTokenLifetime    = "token_lifetime"
+	ClaimAuthorization    = "authorization"
+)
+
+// maxActorLifetime bounds an actor token's own lifetime.
+const maxActorLifetime = 5 * time.Minute
+
+// clockSkew tolerated on iat/nbf of actor tokens.
+const clockSkew = 30 * time.Second
+
+// Config is the "workloadTokenExchange" section of the Dex configuration.
+type Config struct {
+	// Clients are the confidential OAuth clients that may exchange.
+	Clients []string `json:"clients"`
+	// SubjectConnector verifies subject tokens (its own issuer and audience
+	// checks apply).
+	SubjectConnector string `json:"subjectConnector"`
+	// Actors are the trusted actor token issuers.
+	Actors []ActorConfig `json:"actors"`
+	// Outputs are the audiences of tokens that may be issued.
+	Outputs []OutputConfig `json:"outputs"`
+}
+
+// ActorConfig is one trusted actor token issuer.
+type ActorConfig struct {
+	Issuer   string      `json:"issuer"`
+	Audience string      `json:"audience"`
+	Keys     []KeyConfig `json:"keys"`
+}
+
+// KeyConfig is an Ed25519 public key.
+type KeyConfig struct {
+	KeyID string `json:"kid"`
+	// Ed25519 is the raw 32-byte public key, base64url (a JWK OKP "x").
+	Ed25519 string `json:"ed25519"`
+}
+
+// OutputConfig is one audience of issued tokens.
+type OutputConfig struct {
+	Audience string `json:"audience"`
+	Issuer   string `json:"issuer"`
+	// SigningKeyFile is the Ed25519 private key (PEM, PKCS#8); KeyID its "kid".
+	SigningKeyFile string `json:"signingKeyFile"`
+	KeyID          string `json:"keyID"`
+	// MaxLifetime bounds issued tokens (at most 1h).
+	MaxLifetime string `json:"maxLifetime"`
+	// Claims are copied from the actor's "authorization" object.
+	Claims []string `json:"claims"`
+}
+
+// Exchanger verifies actor tokens and issues output tokens.
+type Exchanger struct {
+	clients   []string
+	connector string
+	actors    []actor
+	outputs   map[string]output
+	Now       func() time.Time
+}
+
+type actor struct {
+	issuer, audience string
+	keys             map[string]ed25519.PublicKey
+}
+
+type output struct {
+	audience, issuer, keyID string
+	key                     ed25519.PrivateKey
+	ttl                     time.Duration
+	claims                  []string
+}
+
+// ErrDenied: the exchange is refused. The reason is logged, never returned
+// to the client.
+var ErrDenied = errors.New("workload token exchange denied")
+
+var (
+	identifier = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+	claimName  = regexp.MustCompile(`^[a-z][a-z0-9_]{0,63}$`)
+	// Claims an issued token always sets itself.
+	reserved = []string{"iss", "sub", "aud", "exp", "nbf", "iat", "jti", "act", "azp", "client_id", "scope"}
+)
+
+// New validates c and loads its output keys.
+func New(c Config) (*Exchanger, error) {
+	keys := map[string]ed25519.PrivateKey{}
+	for _, o := range c.Outputs {
+		k, err := loadKey(o.SigningKeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs[%s].signingKeyFile: %v", o.Audience, err)
+		}
+		keys[o.Audience] = k
+	}
+	return NewWithKeys(c, keys)
+}
+
+// NewWithKeys is New with the output keys given by audience (their files are
+// not read).
+func NewWithKeys(c Config, keys map[string]ed25519.PrivateKey) (*Exchanger, error) {
+	e := &Exchanger{clients: c.Clients, connector: c.SubjectConnector, outputs: map[string]output{}, Now: time.Now}
+	if len(c.Clients) == 0 || slices.ContainsFunc(c.Clients, func(s string) bool { return !identifier.MatchString(s) }) {
+		return nil, errors.New("workloadTokenExchange.clients must name client ids")
+	}
+	if !identifier.MatchString(c.SubjectConnector) {
+		return nil, errors.New("workloadTokenExchange.subjectConnector is required")
+	}
+	if len(c.Actors) == 0 {
+		return nil, errors.New("workloadTokenExchange.actors is empty")
+	}
+	for _, a := range c.Actors {
+		if a.Issuer == "" || a.Audience == "" || len(a.Keys) == 0 {
+			return nil, fmt.Errorf("workloadTokenExchange.actors[%s] needs an issuer, an audience and keys", a.Issuer)
+		}
+		if slices.ContainsFunc(e.actors, func(x actor) bool { return x.issuer == a.Issuer }) {
+			return nil, fmt.Errorf("workloadTokenExchange.actors: issuer %q twice", a.Issuer)
+		}
+		ac := actor{issuer: a.Issuer, audience: a.Audience, keys: map[string]ed25519.PublicKey{}}
+		for _, k := range a.Keys {
+			raw, err := base64.RawURLEncoding.DecodeString(k.Ed25519)
+			if err != nil || len(raw) != ed25519.PublicKeySize || !identifier.MatchString(k.KeyID) {
+				return nil, fmt.Errorf("workloadTokenExchange.actors[%s]: kid %q needs a base64url 32-byte Ed25519 key", a.Issuer, k.KeyID)
+			}
+			if _, dup := ac.keys[k.KeyID]; dup {
+				return nil, fmt.Errorf("workloadTokenExchange.actors[%s]: kid %q twice", a.Issuer, k.KeyID)
+			}
+			ac.keys[k.KeyID] = raw
+		}
+		e.actors = append(e.actors, ac)
+	}
+	if len(c.Outputs) == 0 {
+		return nil, errors.New("workloadTokenExchange.outputs is empty")
+	}
+	for _, o := range c.Outputs {
+		if o.Audience == "" || !identifier.MatchString(o.KeyID) {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs[%s] needs an audience and a keyID", o.Audience)
+		}
+		if _, dup := e.outputs[o.Audience]; dup {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs: audience %q twice", o.Audience)
+		}
+		if u, err := url.Parse(o.Issuer); err != nil || u.Scheme != "https" || u.Host == "" {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs[%s].issuer must be an https URL", o.Audience)
+		}
+		ttl, err := time.ParseDuration(o.MaxLifetime)
+		if err != nil || ttl <= 0 || ttl > time.Hour {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs[%s].maxLifetime must be positive and at most 1h", o.Audience)
+		}
+		for _, n := range o.Claims {
+			if !claimName.MatchString(n) || slices.Contains(reserved, n) {
+				return nil, fmt.Errorf("workloadTokenExchange.outputs[%s].claims: %q cannot be copied", o.Audience, n)
+			}
+		}
+		key := keys[o.Audience]
+		if len(key) != ed25519.PrivateKeySize {
+			return nil, fmt.Errorf("workloadTokenExchange.outputs[%s]: an Ed25519 signing key is required", o.Audience)
+		}
+		// Each output is its own signing authority: a service that verifies
+		// only the signature (and not aud or iss) still cannot accept a
+		// token Dex issued for another output.
+		for _, other := range e.outputs {
+			if other.key.Equal(key) || other.issuer == o.Issuer {
+				return nil, fmt.Errorf("workloadTokenExchange.outputs[%s] shares its signing key or issuer with outputs[%s]", o.Audience, other.audience)
+			}
+		}
+		e.outputs[o.Audience] = output{audience: o.Audience, issuer: o.Issuer, keyID: o.KeyID, key: key, ttl: ttl, claims: o.Claims}
+	}
+	return e, nil
+}
+
+func loadKey(file string) (ed25519.PrivateKey, error) {
+	raw, err := os.ReadFile(file)
+	if err != nil {
+		return nil, err
+	}
+	block, _ := pem.Decode(raw)
+	if block == nil || block.Type != "PRIVATE KEY" {
+		return nil, errors.New("not a PEM PRIVATE KEY")
+	}
+	k, err := x509.ParsePKCS8PrivateKey(block.Bytes)
+	key, ok := k.(ed25519.PrivateKey)
+	if err != nil || !ok {
+		return nil, errors.New("not an Ed25519 key")
+	}
+	return key, nil
+}
+
+// Client reports whether clientID may exchange.
+func (e *Exchanger) Client(clientID string) bool { return slices.Contains(e.clients, clientID) }
+
+// Connector is the connector that verifies subject tokens.
+func (e *Exchanger) Connector() string { return e.connector }
+
+// Issued is an issued token.
+type Issued struct {
+	Token    string
+	Expiry   time.Time
+	Audience string
+	Actor    string
+}
+
+// Exchange verifies actorToken for subjectToken (already verified by the
+// connector, whose identity is subject) and issues a token for audience.
+func (e *Exchanger) Exchange(subjectToken, subject, actorToken, audience string) (Issued, error) {
+	out, ok := e.outputs[audience]
+	if !ok {
+		return Issued{}, fmt.Errorf("%w: audience %q is not a configured output", ErrDenied, audience)
+	}
+	if subject == "" {
+		return Issued{}, fmt.Errorf("%w: the subject has no identity", ErrDenied)
+	}
+	now := e.Now().UTC()
+	claims, iss, err := e.verifyActor(actorToken, now)
+	if err != nil {
+		return Issued{}, err
+	}
+	sum := sha256.Sum256([]byte(subjectToken))
+	want := base64.RawURLEncoding.EncodeToString(sum[:])
+	got, _ := claims[ClaimSubjectTokenHash].(string)
+	if subtle.ConstantTimeCompare([]byte(got), []byte(want)) != 1 {
+		return Issued{}, fmt.Errorf("%w: the actor token is not bound to this subject token", ErrDenied)
+	}
+	if t, _ := claims[ClaimTargetAudience].(string); t != audience {
+		return Issued{}, fmt.Errorf("%w: the actor token is for audience %q, not %q", ErrDenied, t, audience)
+	}
+	ttl := out.ttl
+	if v, present := claims[ClaimTokenLifetime]; present {
+		n, ok := v.(float64)
+		if !ok || n < 1 || n != float64(int64(n)) {
+			return Issued{}, fmt.Errorf("%w: %s must be a positive number of seconds", ErrDenied, ClaimTokenLifetime)
+		}
+		if d := time.Duration(n) * time.Second; d < ttl {
+			ttl = d
+		}
+	}
+	authz, _ := claims[ClaimAuthorization].(map[string]any)
+	if authz == nil {
+		return Issued{}, fmt.Errorf("%w: the actor token has no %s object", ErrDenied, ClaimAuthorization)
+	}
+	now = now.Truncate(time.Second)
+	exp := now.Add(ttl)
+	jti := make([]byte, 16)
+	if _, err := rand.Read(jti); err != nil {
+		return Issued{}, err
+	}
+	c := map[string]any{"iss": out.issuer, "sub": subject, "aud": out.audience,
+		"iat": now.Unix(), "nbf": now.Unix(), "exp": exp.Unix(), "jti": hex.EncodeToString(jti)}
+	for _, n := range out.claims {
+		if v, ok := authz[n]; ok {
+			c[n] = v
+		}
+	}
+	token, err := sign(out.key, out.keyID, c)
+	if err != nil {
+		return Issued{}, err
+	}
+	return Issued{Token: token, Expiry: exp, Audience: audience, Actor: iss}, nil
+}
+
+// verifyActor verifies an actor token's signature, issuer, audience and
+// lifetime, and returns its claims and issuer.
+func (e *Exchanger) verifyActor(token string, now time.Time) (map[string]any, string, error) {
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		return nil, "", fmt.Errorf("%w: the actor token is not a JWS", ErrDenied)
+	}
+	var header struct {
+		Alg  string `json:"alg"`
+		Kid  string `json:"kid"`
+		Crit any    `json:"crit"`
+	}
+	if err := decode(parts[0], &header); err != nil || header.Alg != "EdDSA" || header.Crit != nil {
+		return nil, "", fmt.Errorf("%w: the actor token is not an EdDSA JWS", ErrDenied)
+	}
+	var claims map[string]any
+	if err := decode(parts[1], &claims); err != nil {
+		return nil, "", fmt.Errorf("%w: the actor token claims: %v", ErrDenied, err)
+	}
+	iss, _ := claims["iss"].(string)
+	i := slices.IndexFunc(e.actors, func(a actor) bool { return a.issuer == iss })
+	if i < 0 {
+		return nil, "", fmt.Errorf("%w: actor issuer %q is not trusted", ErrDenied, iss)
+	}
+	a := e.actors[i]
+	key, ok := a.keys[header.Kid]
+	if !ok {
+		return nil, "", fmt.Errorf("%w: actor %s has no key %q", ErrDenied, iss, header.Kid)
+	}
+	sig, err := base64.RawURLEncoding.DecodeString(parts[2])
+	if err != nil || !ed25519.Verify(key, []byte(parts[0]+"."+parts[1]), sig) {
+		return nil, "", fmt.Errorf("%w: the actor token signature is not valid", ErrDenied)
+	}
+	if !audienceContains(claims["aud"], a.audience) {
+		return nil, "", fmt.Errorf("%w: the actor token is not for audience %q", ErrDenied, a.audience)
+	}
+	exp, okExp := unix(claims["exp"])
+	iat, okIat := unix(claims["iat"])
+	switch {
+	case !okExp || !okIat:
+		return nil, "", fmt.Errorf("%w: the actor token needs exp and iat", ErrDenied)
+	case !now.Before(exp):
+		return nil, "", fmt.Errorf("%w: the actor token expired", ErrDenied)
+	case iat.After(now.Add(clockSkew)):
+		return nil, "", fmt.Errorf("%w: the actor token is issued in the future", ErrDenied)
+	case exp.Sub(iat) > maxActorLifetime:
+		return nil, "", fmt.Errorf("%w: the actor token lives longer than %s", ErrDenied, maxActorLifetime)
+	}
+	if nbf, ok := unix(claims["nbf"]); ok && nbf.After(now.Add(clockSkew)) {
+		return nil, "", fmt.Errorf("%w: the actor token is not valid yet", ErrDenied)
+	}
+	return claims, iss, nil
+}
+
+func audienceContains(aud any, want string) bool {
+	switch v := aud.(type) {
+	case string:
+		return v == want
+	case []any:
+		return slices.ContainsFunc(v, func(x any) bool { s, _ := x.(string); return s == want })
+	}
+	return false
+}
+
+func unix(v any) (time.Time, bool) {
+	n, ok := v.(float64)
+	if !ok || n <= 0 {
+		return time.Time{}, false
+	}
+	return time.Unix(int64(n), 0), true
+}
+
+func decode(part string, v any) error {
+	raw, err := base64.RawURLEncoding.DecodeString(part)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(raw, v)
+}
+
+func sign(key ed25519.PrivateKey, kid string, claims map[string]any) (string, error) {
+	header, _ := json.Marshal(map[string]string{"alg": "EdDSA", "typ": "JWT", "kid": kid})
+	body, err := json.Marshal(claims)
+	if err != nil {
+		return "", err
+	}
+	in := base64.RawURLEncoding.EncodeToString(header) + "." + base64.RawURLEncoding.EncodeToString(body)
+	return in + "." + base64.RawURLEncoding.EncodeToString(ed25519.Sign(key, []byte(in))), nil
+}
