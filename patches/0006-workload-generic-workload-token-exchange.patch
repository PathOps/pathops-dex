+package workload
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func validConfig(pub ed25519.PublicKey) Config {
+	return Config{
+		Clients:          []string{"pathops-tenant-control-plane"},
+		SubjectConnector: "k8s-cell",
+		Actors: []ActorConfig{{Issuer: "pathops-tenant-control-plane", Audience: "pathops-workload-exchange",
+			Keys: []KeyConfig{{KeyID: "tcp-workload-1", Ed25519: base64.RawURLEncoding.EncodeToString(pub)}}}},
+		Outputs: []OutputConfig{{Audience: "pathops-registry", Issuer: "https://dex.example.org/registry", KeyID: "registry-1",
+			MaxLifetime: "30m", Claims: []string{"access"}}},
+	}
+}
+
+func TestNewValidatesConfig(t *testing.T) {
+	pub, _, _ := ed25519.GenerateKey(rand.Reader)
+	_, out, _ := ed25519.GenerateKey(rand.Reader)
+	keys := map[string]ed25519.PrivateKey{"pathops-registry": out}
+	_, err := NewWithKeys(validConfig(pub), keys)
+	require.NoError(t, err)
+
+	for name, mutate := range map[string]func(*Config){
+		"no clients":           func(c *Config) { c.Clients = nil },
+		"no connector":         func(c *Config) { c.SubjectConnector = "" },
+		"no actors":            func(c *Config) { c.Actors = nil },
+		"bad actor key":        func(c *Config) { c.Actors[0].Keys[0].Ed25519 = "short" },
+		"actor without aud":    func(c *Config) { c.Actors[0].Audience = "" },
+		"no outputs":           func(c *Config) { c.Outputs = nil },
+		"http output issuer":   func(c *Config) { c.Outputs[0].Issuer = "http://dex.example.org/registry" },
+		"lifetime above 1h":    func(c *Config) { c.Outputs[0].MaxLifetime = "2h" },
+		"no lifetime":          func(c *Config) { c.Outputs[0].MaxLifetime = "" },
+		"reserved claim":       func(c *Config) { c.Outputs[0].Claims = []string{"sub"} },
+		"bad claim name":       func(c *Config) { c.Outputs[0].Claims = []string{"Access-Claim"} },
+		"output without a key": func(c *Config) { c.Outputs[0].Audience = "other" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			c := validConfig(pub)
+			mutate(&c)
+			_, err := NewWithKeys(c, keys)
+			require.Error(t, err)
+		})
+	}
+}
+
+// Two outputs never share a signing key or an issuer: a service that checks
+// only the signature cannot accept another output's token.
+func TestNewRefusesSharedOutputAuthority(t *testing.T) {
+	pub, _, _ := ed25519.GenerateKey(rand.Reader)
+	_, registry, _ := ed25519.GenerateKey(rand.Reader)
+	_, artifacts, _ := ed25519.GenerateKey(rand.Reader)
+	second := OutputConfig{Audience: "pathops-artifact-store", Issuer: "https://dex.example.org/artifacts", KeyID: "artifact-1",
+		MaxLifetime: "5m", Claims: []string{"pathops_application"}}
+	c := validConfig(pub)
+	c.Outputs = append(c.Outputs, second)
+	_, err := NewWithKeys(c, map[string]ed25519.PrivateKey{"pathops-registry": registry, "pathops-artifact-store": artifacts})
+	require.NoError(t, err)
+
+	_, err = NewWithKeys(c, map[string]ed25519.PrivateKey{"pathops-registry": registry, "pathops-artifact-store": registry})
+	require.ErrorContains(t, err, "shares its signing key or issuer")
+
+	c.Outputs[1].Issuer = c.Outputs[0].Issuer
+	_, err = NewWithKeys(c, map[string]ed25519.PrivateKey{"pathops-registry": registry, "pathops-artifact-store": artifacts})
+	require.ErrorContains(t, err, "shares its signing key or issuer")
+}
+
+func TestExchangeRefusesMalformedActorTokens(t *testing.T) {
+	pub, _, _ := ed25519.GenerateKey(rand.Reader)
+	_, out, _ := ed25519.GenerateKey(rand.Reader)
+	e, err := NewWithKeys(validConfig(pub), map[string]ed25519.PrivateKey{"pathops-registry": out})
+	require.NoError(t, err)
+	none := base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"none"}`)) + "." +
+		base64.RawURLEncoding.EncodeToString([]byte(`{"iss":"pathops-tenant-control-plane"}`)) + "."
+	for _, tok := range []string{"", "a.b", "a.b.c", none, strings.Repeat("x.", 2) + "y"} {
+		_, err := e.Exchange("subject", "system:serviceaccount:a:b", tok, "pathops-registry")
+		require.ErrorIs(t, err, ErrDenied, tok)
+	}
+	_, err = e.Exchange("subject", "", none, "pathops-registry")
+	require.ErrorIs(t, err, ErrDenied)
+}
