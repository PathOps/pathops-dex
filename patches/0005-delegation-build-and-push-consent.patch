+
+// The bundled consent screen shows BUILD_AND_PUSH credentials and Kubernetes
+// objects.
+func TestDelegationTemplateBuildAndPush(t *testing.T) {
+	_, _, _, tmpls, err := LoadWebConfig(Config{WebFS: os.DirFS("../../web"), Issuer: "dex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	page := DelegationPage{User: "gaston", Delegate: "PathOps Tenant Control Plane", Consent: delegation.Consent{Tools: []delegation.ConsentTool{
+		{Name: "forgejo", DisplayName: "Forgejo",
+			RepositoryTokens: []delegation.ConsentRepositoryToken{{Repository: "gaston/app-a", Name: "pathops-resolution-x", Scopes: []string{"read:repository"}}},
+			DeployKeys:       []delegation.ConsentDeployKey{{Repository: "gaston/app-a", Title: "pathops-checkout-x", ReadOnly: true}}},
+		{Name: "kubernetes", DisplayName: "Kubernetes",
+			KubernetesResources: []delegation.ConsentKubernetesResource{{Kind: "namespaces", Name: "app-a-ci"}}},
+	}}}
+	rr := httptest.NewRecorder()
+	if err := tmpls.Delegation(httptest.NewRequest(http.MethodGet, "/approval", nil), rr, page); err != nil {
+		t.Fatal(err)
+	}
+	body := rr.Body.String()
+	for _, want := range []string{"Repository read tokens", "pathops-resolution-x", "read:repository",
+		"Deploy keys", "pathops-checkout-x", "read-only", "Kubernetes objects", "app-a-ci", "<code>namespaces</code>"} {
+		if !strings.Contains(body, want) {
+			t.Errorf("the consent screen does not show %q", want)
+		}
+	}
+	if strings.Contains(body, "Other resources") {
+		t.Error("BUILD_AND_PUSH details are shown as other resources")
+	}
+}
